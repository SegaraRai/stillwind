{
  "extends": "../../../tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite-plus/client", "@builder.io/qwik-city"],
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "fixture.ts", "tests/**/*.ts", "*.config.ts"]
}
