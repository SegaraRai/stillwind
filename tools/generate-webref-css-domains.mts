import { readFile, writeFile } from "node:fs/promises";

type CssProperty = {
  href: string;
  name: string;
  syntax?: string;
};

type WebrefCss = {
  properties: CssProperty[];
};

const source = new URL("./node_modules/@webref/css/css.json", import.meta.url);
const destination = new URL("../crates/css/assets/webref-properties.rs", import.meta.url);

function rustString(value: string): string {
  return JSON.stringify(value);
}

function render(properties: CssProperty[]): string {
  const definitions = properties
    .filter((property) => property.syntax)
    .sort((left, right) => left.name.localeCompare(right.name))
    .map(
      (property) =>
        `  WebrefPropertySyntax { name: ${rustString(property.name)}, syntax: ${rustString(property.syntax!)}, href: ${rustString(property.href)} },`,
    );
  return `// @generated by tools/generate-webref-css-domains.mts; DO NOT EDIT.\n// Source: curated @webref/css css.json (CSSWG Web Living Standards).\npub(crate) const WEBREF_PROPERTIES: &[WebrefPropertySyntax] = &[\n${definitions.join("\n")}\n];\n`;
}

const webref = JSON.parse(await readFile(source, "utf8")) as WebrefCss;
const generated = render(webref.properties);

if (process.argv.includes("--check")) {
  const current = await readFile(destination, "utf8");
  if (current !== generated) {
    throw new Error("Webref CSS domain snapshot is stale; run generate-webref-css-domains.mts");
  }
} else {
  await writeFile(destination, generated);
}
