      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["border-t-red-500", "border-r-red-500", "border-b-red-500", "border-l-red-500"],
      "expected": ["border-red-500"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["scroll-mt-1", "scroll-mr-1", "scroll-mb-1", "scroll-ml-1"],
