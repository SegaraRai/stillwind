    },
    {
      "input": ["[font-size:14px]", "[line-height:1.625]"],
      "expected": ["text-sm/relaxed"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    }
  ]
}
