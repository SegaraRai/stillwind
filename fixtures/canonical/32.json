{
  "name": "regressions",
  "css": "@import 'tailwindcss';\n        @theme {\n          --tracking-tighter: -0.05em;\n          --tracking-tight: -0.025em;\n          --tracking-normal: 0em;\n          --tracking-wide: 0.025em;\n          --tracking-wider: 0.05em;\n          --tracking-widest: 0.1em;\n        }",
