{
  "name": "modernize arbitrary variants",
  "css": "@import 'tailwindcss';",
  "baseTheme": "@theme { --*:initial; --breakpoint-lg:64rem; --breakpoint-md:48rem; --color-blue-200:oklch(88.2% 0.059 254.128); --color-blue-500:oklch(62.3% 0.214 259.815); --color-red-500:oklch(63.7% 0.237 25.331); --color-white:#fff; --container-md:28rem; --font-weight-normal:400; --leading-relaxed:1.625; --spacing:.25rem; --text-sm--line-height:calc(1.25 / .875); --text-sm:.875rem; --text-xs--line-height:calc(1 / .75); --text-xs:.75rem; }",
  "cases": [
    {
      "input": ["[@media_not_print]:flex"],
      "expected": ["not-print:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["[@media_not_(prefers-color-scheme:dark)]:flex"],
      "expected": ["not-dark:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["[@media_not_(prefers-color-scheme:unknown)]:flex"],
      "expected": ["not-[@media_(prefers-color-scheme:unknown)]:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["has-[[data-visible]]:flex"],
      "expected": ["has-data-visible:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["has-[&:is([data-visible])]:flex"],
      "expected": ["has-data-visible:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["has-[&>[data-visible]]:flex"],
      "expected": ["has-[&>[data-visible]]:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["has-[[data-slot=description]]:flex"],
      "expected": ["has-data-[slot=description]:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["has-[&:is([data-slot=description])]:flex"],
      "expected": ["has-data-[slot=description]:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["has-[[aria-visible=\"true\"]]:flex"],
      "expected": ["has-aria-visible:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["has-[[aria-visible]]:flex"],
      "expected": ["has-aria-[visible]:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["has-[&:not(:nth-child(even))]:flex"],
      "expected": ["has-odd:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["[&:has([role=checkbox])]:flex"],
      "expected": ["has-[[role=checkbox]]:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["[&:has([aria-visible=\"true\"])]:flex"],
      "expected": ["has-aria-visible:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["[&:has([data-slot=description])]:flex"],
      "expected": ["has-data-[slot=description]:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    }
  ]
}
