{
  "name": "regressions",
  "css": "@import 'tailwindcss';",
  "baseTheme": "@theme { --*:initial; --breakpoint-lg:64rem; --breakpoint-md:48rem; --color-blue-200:oklch(88.2% 0.059 254.128); --color-blue-500:oklch(62.3% 0.214 259.815); --color-red-500:oklch(63.7% 0.237 25.331); --color-white:#fff; --container-md:28rem; --font-weight-normal:400; --leading-relaxed:1.625; --spacing:.25rem; --text-sm--line-height:calc(1.25 / .875); --text-sm:.875rem; --text-xs--line-height:calc(1 / .75); --text-xs:.75rem; }",
  "cases": [
    {
      "input": ["[&:has(~_*_*:checked)]:flex"],
      "expected": ["[&:has(~_*_*:checked)]:flex"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["shadow-[inset_0px_1px_--theme(--color-white/15%)]"],
      "expected": ["shadow-[inset_0px_1px_--theme(--color-white/15%)]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["w-[calc(100%_-_calc(var(--spacing)*60))]"],
      "expected": ["w-[calc(100%-(--spacing(60)))]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["w-[calc(100%_-_--spacing(60))]"],
      "expected": ["w-[calc(100%-(--spacing(60)))]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["m-[min(100%,_--spacing(6))]"],
      "expected": ["m-[min(100%,--spacing(6))]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["m-[min(100%_,_--spacing(6))]"],
      "expected": ["m-[min(100%,--spacing(6))]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["m-[min(100%,--spacing(6))]"],
      "expected": ["m-[min(100%,--spacing(6))]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["-mt-[0.04in]"],
      "expected": ["mt-[-0.04in]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["mt-[-0.04in]"],
      "expected": ["mt-[-0.04in]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["-mt-[-0.04in]"],
      "expected": ["mt-[0.04in]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["w-[calc(100%/3.5)]"],
      "expected": ["w-[calc(100%/3.5)]"],
      "options": {
        "rem": 16,
        "collapse": true,
        "logicalToPhysical": true
      }
    },
    {
      "input": ["underline", "h-4", "w-4", "text-sm"],
      "expected": ["underline", "text-sm", "size-4"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      }
    },
    {
      "input": ["underline", "h-4", "w-4"],
      "expected": ["underline", "size-4"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      }
    },
    {
      "input": ["underline", "h-4", "w-4"],
      "expected": ["underline", "size-4"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      }
    },
    {
      "input": ["underline", "h-4", "w-4", "text-sm"],
      "expected": ["underline", "text-sm", "size-4"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      }
    },
    {
      "input": ["shadow-sm", "border"],
      "expected": ["shadow-sm", "border"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      },
      "contains": true
    },
    {
      "input": ["shadow-sm", "shadow-md"],
      "expected": ["shadow-sm", "shadow-md"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      },
      "contains": true
    },
    {
      "input": ["px-[1.2rem]", "py-[1.2rem]", "text-left"],
      "expected": ["text-left", "p-[1.2rem]"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      }
    },
    {
      "input": ["px-[30.75rem]", "py-[30.75rem]", "text-left"],
      "expected": ["text-left", "p-123"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      }
    },
    {
      "input": ["px-[calc(1rem+0px)]"],
      "expected": ["px-4"],
      "options": {
        "collapse": true,
        "logicalToPhysical": true,
        "rem": 16
      }
    }
  ]
}
