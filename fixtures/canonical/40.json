{
  "name": "named variants retain their spelling",
  "css": "@import 'tailwindcss'; @custom-variant authored-focus (&:focus);",
  "baseTheme": "@theme { --*:initial; --breakpoint-lg:64rem; --breakpoint-md:48rem; --color-blue-200:oklch(88.2% 0.059 254.128); --color-blue-500:oklch(62.3% 0.214 259.815); --color-red-500:oklch(63.7% 0.237 25.331); --color-white:#fff; --container-md:28rem; --font-weight-normal:400; --leading-relaxed:1.625; --spacing:.25rem; --text-sm--line-height:calc(1.25 / .875); --text-sm:.875rem; --text-xs--line-height:calc(1 / .75); --text-xs:.75rem; }",
  "cases": [
    {
      "input": ["authored-focus:flex"],
      "expected": ["authored-focus:flex"]
    },
    {
      "input": ["focus:flex"],
      "expected": ["focus:flex"]
    },
    {
      "input": ["lg:focus:flex"],
      "expected": ["lg:focus:flex"]
    },
    {
      "input": ["lg:authored-focus:flex"],
      "expected": ["lg:authored-focus:flex"]
    },
    {
      "input": ["lg:group-focus:flex"],
      "expected": ["lg:group-focus:flex"]
    }
  ]
}
