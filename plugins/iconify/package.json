{
  "name": "@stillwind/plugin-iconify",
  "version": "0.10.1",
  "description": "Iconify icons as Stillwind utilities, with only the icons you use in the CSS",
  "keywords": [
    "css-icons",
    "iconify",
    "icons",
    "stillwind",
    "stillwind-plugin",
    "svg",
    "svg-icons"
  ],
  "homepage": "https://stillwind.dev",
  "bugs": {
    "url": "https://github.com/SegaraRai/stillwind/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegaraRai/stillwind.git",
    "directory": "plugins/iconify"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
