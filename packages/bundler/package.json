{
  "name": "@stillwind/bundler",
  "version": "0.0.0",
  "description": "Stillwind adapters for webpack, Rspack, Rsbuild and Next.js",
  "license": "MIT",
  "files": [
    "*.cjs",
    "*.d.ts",
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./loader": "./loader.cjs",
    "./css-loader": "./css-loader.cjs"
  },
  "dependencies": {
    "@stillwind/host": "workspace:*",
    "@stillwind/native": "workspace:*"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@rspack/core": "^2.2.3",
    "@swc/core": "^1.16.2",
    "@types/node": "catalog:",
    "css-loader": "^7.1.5",
    "stillwind": "workspace:*",
    "svelte": "^5.57.0",
    "svelte-loader": "^3.2.4",
    "swc-loader": "^0.2.7",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.42",
    "vue-loader": "^17.4.2",
    "webpack": "^5.110.3"
  }
}
