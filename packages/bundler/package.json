{
  "name": "@stillwind/bundler",
  "version": "0.0.0",
  "description": "Stillwind adapters for webpack, Rspack, Rsbuild and Next.js",
  "license": "MIT",
  "files": [
    "*.cjs",
    "*.d.ts",
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./loader": "./loader.cjs",
    "./css-loader": "./css-loader.cjs"
  },
  "dependencies": {
    "@stillwind/host": "workspace:*",
    "@stillwind/native": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
