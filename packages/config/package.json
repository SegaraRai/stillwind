{
  "name": "@stillwind/config",
  "version": "0.1.0-rc.0",
  "description": "Shared configuration for Stillwind builds and analysis",
  "homepage": "https://stillwind.dev/",
  "bugs": {
    "url": "https://github.com/SegaraRai/stillwind/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegaraRai/stillwind.git",
    "directory": "packages/config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stillwind/native": "workspace:*",
    "@stillwind/projection": "workspace:*",
    "jiti": "^2.7.0",
    "pathe": "catalog:",
    "rolldown": "catalog:",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
