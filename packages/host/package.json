{
  "name": "@stillwind/host",
  "version": "0.10.1",
  "description": "Host services shared by Stillwind's build integrations and analysis tools",
  "keywords": [
    "stillwind"
  ],
  "homepage": "https://stillwind.dev",
  "bugs": {
    "url": "https://github.com/SegaraRai/stillwind/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegaraRai/stillwind.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "default": "./dist/projection.js"
    },
    "./resolution": {
      "types": "./dist/resolution.d.ts",
      "default": "./dist/resolution.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "catalog:",
    "@jridgewell/remapping": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@stillwind/config": "workspace:*",
    "@stillwind/native": "workspace:*",
    "@stillwind/projection": "workspace:*",
    "minimatch": "^11.0.5",
    "oxc-resolver": "^11.24.2",
    "pathe": "catalog:",
    "tinyglobby": "^0.2.17",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript-6": "npm:typescript@^6.0.3"
  },
  "devDependencies": {
    "@astrojs/astro2tsx": "0.1.4",
    "@astrojs/compiler": "4.0.0",
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "@vue/compiler-sfc": "^3.5.45",
    "stillwind": "workspace:*",
    "svelte": "^5.57.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue-language-core-3-0-2": "npm:@vue/language-core@3.0.2",
    "vue-language-core-3-0-6": "npm:@vue/language-core@3.0.6",
    "vue-language-core-3-1-0": "npm:@vue/language-core@3.1.0",
    "vue-language-core-3-1-6": "npm:@vue/language-core@3.1.6",
    "vue-language-core-3-2-0": "npm:@vue/language-core@3.2.0",
    "vue-language-core-3-3-12": "npm:@vue/language-core@3.3.12"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
