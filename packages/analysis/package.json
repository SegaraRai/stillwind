{
  "name": "@stillwind/analysis",
  "version": "0.0.0",
  "description": "Analysis services for Stillwind tools",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stillwind/config": "workspace:*",
    "@stillwind/host": "workspace:*",
    "@stillwind/native": "workspace:*",
    "minimatch": "^10.2.6",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
