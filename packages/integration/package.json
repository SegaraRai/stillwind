{
  "name": "@stillwind/integration",
  "version": "0.3.0",
  "description": "Build tool integrations for Stillwind",
  "homepage": "https://stillwind.dev",
  "bugs": {
    "url": "https://github.com/SegaraRai/stillwind/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegaraRai/stillwind.git",
    "directory": "packages/integration"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./fresh": {
      "types": "./dist/fresh/index.d.ts",
      "default": "./dist/fresh/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/index.d.ts",
      "default": "./dist/nuxt/index.js"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild/index.d.ts",
      "default": "./dist/rsbuild/index.js"
    },
    "./rspack": {
      "types": "./dist/rspack/index.d.ts",
      "default": "./dist/rspack/index.js"
    },
    "./sveltekit/handle": {
      "types": "./dist/sveltekit/handle.d.ts",
      "default": "./dist/sveltekit/handle.js"
    },
    "./turbopack": {
      "types": "./dist/turbopack/index.d.ts",
      "default": "./dist/turbopack/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./webpack": {
      "types": "./dist/webpack/index.d.ts",
      "default": "./dist/webpack/index.js"
    },
    "./internal/astro-development": {
      "types": "./dist/astro/development.d.ts",
      "default": "./dist/astro/development.js"
    },
    "./internal/webpack-loader": {
      "types": "./dist/webpack/loader.d.ts",
      "default": "./dist/webpack/loader.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "catalog:",
    "@jridgewell/remapping": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@stillwind/config": "workspace:*",
    "@stillwind/host": "workspace:*",
    "@stillwind/native": "workspace:*",
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.0",
    "@rspack/core": "^2.3.0",
    "@stillwind-internal/tools-fixture-css": "workspace:*",
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@swc/core": "^1.16.20",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.10",
    "astro": "^7.4.4",
    "css-loader": "^7.1.5",
    "next": "^16.4.3",
    "nuxt": "^4.6.3",
    "stillwind": "workspace:*",
    "svelte": "^5.57.3",
    "svelte-loader": "^3.2.4",
    "swc-loader": "^0.2.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.44",
    "vue-loader": "^17.4.2",
    "webpack": "^5.112.2"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "@rspack/core": "^2.0.0",
    "@sveltejs/kit": "^2.0.0 || ^3.0.0",
    "astro": "^6.0.0 || ^7.0.0",
    "nuxt": "^4.0.0",
    "stillwind": "workspace:*",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
