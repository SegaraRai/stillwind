{
  "name": "@stillwind/vscode-extension",
  "version": "0.1.0",
  "description": "Stillwind language support for VS Code and browser editors",
  "homepage": "https://stillwind.dev",
  "bugs": {
    "url": "https://github.com/SegaraRai/stillwind/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegaraRai/stillwind.git",
    "directory": "packages/vscode-extension"
  },
  "files": [
    "dist/api",
    "dist/extension",
    "README.md",
    "LICENSE",
    "TAILWINDCSS-MIT-LICENSE",
    "WEBREF-MIT-LICENSE"
  ],
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./dist/api/manifest.d.ts",
      "default": "./dist/api/manifest.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rolldown/browser": "catalog:",
    "@stillwind/analysis": "workspace:*",
    "@stillwind/config": "workspace:*",
    "@stillwind/host": "workspace:*",
    "@stillwind/language-server": "workspace:*",
    "@stillwind/native": "workspace:*",
    "pathe": "catalog:",
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver": "^11.0.0"
  },
  "devDependencies": {
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "latest",
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^1.3.0",
    "playwright": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
