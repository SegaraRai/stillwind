{
  "name": "@stillwind/native",
  "version": "0.0.0",
  "description": "Native Node-API binding for the Stillwind compiler",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "@stillwind/native-darwin-arm64": "workspace:*",
    "@stillwind/native-darwin-x64": "workspace:*",
    "@stillwind/native-linux-arm64-gnu": "workspace:*",
    "@stillwind/native-linux-x64-gnu": "workspace:*",
    "@stillwind/native-win32-arm64-msvc": "workspace:*",
    "@stillwind/native-win32-x64-msvc": "workspace:*"
  },
  "napi": {
    "binaryName": "stillwind_native",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "wasm32-wasip1-threads"
    ]
  }
}
