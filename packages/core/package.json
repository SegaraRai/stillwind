{
  "name": "stillwind",
  "version": "0.9.0",
  "description": "Write Tailwind CSS v4 utilities in components, enforce your design system, and ship static CSS",
  "keywords": [
    "alpinejs",
    "astro",
    "atomic-css",
    "css",
    "css-compiler",
    "design-system",
    "design-tokens",
    "lit",
    "preact",
    "qwik",
    "react",
    "solid-js",
    "static-css",
    "stillwind",
    "svelte",
    "tailwind",
    "tailwindcss",
    "utility-classes",
    "utility-first",
    "vue",
    "web-components",
    "zero-runtime"
  ],
  "homepage": "https://stillwind.dev",
  "bugs": {
    "url": "https://github.com/SegaraRai/stillwind/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegaraRai/stillwind.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "index.css",
    "index.d.ts",
    "css",
    "docs",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "AGENTS_TEMPLATE.md",
    "TAILWINDCSS-MIT-LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.css",
    "./builtins.css": "./css/builtins.css",
    "./preflight.css": "./css/preflight.css",
    "./templates.css": "./css/templates.css",
    "./theme.css": "./css/theme.css",
    "./utilities.css": "./css/utilities.css",
    "./logical/divide.css": "./css/logical/divide.css",
    "./logical/overflow.css": "./css/logical/overflow.css",
    "./logical/overscroll.css": "./css/logical/overscroll.css",
    "./logical/resize.css": "./css/logical/resize.css",
    "./logical/snap.css": "./css/logical/snap.css",
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/css.js"
    },
    "./module-css": {
      "types": "./dist/module-css.d.ts",
      "default": "./dist/module-css.js"
    },
    "./macro": {
      "types": "./dist/macro/index.d.ts",
      "default": "./dist/macro/index.js"
    },
    "./alpine": {
      "types": "./dist/frameworks/alpine.d.ts",
      "default": "./dist/frameworks/alpine.js"
    },
    "./astro": {
      "types": "./dist/frameworks/astro.d.ts",
      "default": "./dist/frameworks/astro.js"
    },
    "./lit": {
      "types": "./dist/frameworks/lit.d.ts",
      "default": "./dist/frameworks/lit.js"
    },
    "./preact": {
      "types": "./dist/frameworks/preact.d.ts",
      "default": "./dist/frameworks/preact.js"
    },
    "./qwik": {
      "types": "./dist/frameworks/qwik.d.ts",
      "default": "./dist/frameworks/qwik.js"
    },
    "./react": {
      "types": "./dist/frameworks/react.d.ts",
      "default": "./dist/frameworks/react.js"
    },
    "./solid": {
      "types": "./dist/frameworks/solid.d.ts",
      "default": "./dist/frameworks/solid.js"
    },
    "./svelte": {
      "types": "./dist/frameworks/svelte.d.ts",
      "default": "./dist/frameworks/svelte.js"
    },
    "./vanilla": {
      "types": "./dist/frameworks/vanilla.d.ts",
      "default": "./dist/frameworks/vanilla.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue.d.ts",
      "default": "./dist/frameworks/vue.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./runtime/development": {
      "types": "./dist/runtime/development.d.ts",
      "default": "./dist/runtime/development.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@stillwind/config": "workspace:*",
    "@stillwind/native": "workspace:*",
    "@stillwind/projection": "workspace:*"
  },
  "devDependencies": {
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "lit": "^3.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  }
}
