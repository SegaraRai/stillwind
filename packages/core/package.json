{
  "name": "stillwind",
  "version": "0.0.0",
  "description": "CSS definitions and framework adapters for Stillwind",
  "license": "MIT",
  "files": [
    "dist",
    "index.css",
    "css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./index.css",
    "./builtins.css": "./css/builtins.css",
    "./preflight.css": "./css/preflight.css",
    "./templates.css": "./css/templates.css",
    "./theme.css": "./css/theme.css",
    "./utilities.css": "./css/utilities.css",
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/css.js"
    },
    "./module-css": {
      "types": "./dist/module-css.d.ts",
      "default": "./dist/module-css.js"
    },
    "./macro": {
      "types": "./dist/macro/index.d.ts",
      "default": "./dist/macro/index.js"
    },
    "./astro": {
      "types": "./dist/frameworks/astro.d.ts",
      "default": "./dist/frameworks/astro.js"
    },
    "./preact": {
      "types": "./dist/frameworks/preact.d.ts",
      "default": "./dist/frameworks/preact.js"
    },
    "./react": {
      "types": "./dist/frameworks/react.d.ts",
      "default": "./dist/frameworks/react.js"
    },
    "./solid": {
      "types": "./dist/frameworks/solid.d.ts",
      "default": "./dist/frameworks/solid.js"
    },
    "./svelte": {
      "types": "./dist/frameworks/svelte.d.ts",
      "default": "./dist/frameworks/svelte.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue.d.ts",
      "default": "./dist/frameworks/vue.js"
    },
    "./runtime/astro": {
      "types": "./dist/runtime/astro.d.ts",
      "default": "./dist/runtime/astro.js"
    },
    "./runtime/astro-development": {
      "types": "./dist/runtime/astro-development.d.ts",
      "default": "./dist/runtime/astro-development.js"
    },
    "./runtime/preact": {
      "types": "./dist/runtime/preact.d.ts",
      "default": "./dist/runtime/preact.js"
    },
    "./runtime/preact-development": {
      "types": "./dist/runtime/preact-development.d.ts",
      "default": "./dist/runtime/preact-development.js"
    },
    "./runtime/react": {
      "types": "./dist/runtime/react.d.ts",
      "default": "./dist/runtime/react.js"
    },
    "./runtime/react-development": {
      "types": "./dist/runtime/react-development.d.ts",
      "default": "./dist/runtime/react-development.js"
    },
    "./runtime/solid": {
      "types": "./dist/runtime/solid.d.ts",
      "default": "./dist/runtime/solid.js"
    },
    "./runtime/solid-development": {
      "types": "./dist/runtime/solid-development.d.ts",
      "default": "./dist/runtime/solid-development.js"
    },
    "./runtime/svelte": {
      "types": "./dist/runtime/svelte.d.ts",
      "default": "./dist/runtime/svelte.js"
    },
    "./runtime/svelte-development": {
      "types": "./dist/runtime/svelte-development.d.ts",
      "default": "./dist/runtime/svelte-development.js"
    },
    "./runtime/vue": {
      "types": "./dist/runtime/vue.d.ts",
      "default": "./dist/runtime/vue.js"
    },
    "./runtime/vue-development": {
      "types": "./dist/runtime/vue-development.d.ts",
      "default": "./dist/runtime/vue-development.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@stillwind/config": "workspace:*",
    "@stillwind/native": "workspace:*",
    "@stillwind/projection": "workspace:*"
  },
  "devDependencies": {
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
