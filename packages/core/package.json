{
  "name": "stillwind",
  "version": "0.0.0",
  "description": "CSS definitions and framework adapters for Stillwind",
  "license": "MIT",
  "files": [
    "dist",
    "index.css",
    "css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./index.css",
    "./builtins.css": "./css/builtins.css",
    "./preflight.css": "./css/preflight.css",
    "./templates.css": "./css/templates.css",
    "./theme.css": "./css/theme.css",
    "./utilities.css": "./css/utilities.css",
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/css.js"
    },
    "./module-css": {
      "types": "./dist/module-css.d.ts",
      "default": "./dist/module-css.js"
    },
    "./macro": {
      "types": "./dist/macro/index.d.ts",
      "default": "./dist/macro/index.js"
    },
    "./alpine": {
      "types": "./dist/frameworks/alpine.d.ts",
      "default": "./dist/frameworks/alpine.js"
    },
    "./astro": {
      "types": "./dist/frameworks/astro.d.ts",
      "default": "./dist/frameworks/astro.js"
    },
    "./lit": {
      "types": "./dist/frameworks/lit.d.ts",
      "default": "./dist/frameworks/lit.js"
    },
    "./preact": {
      "types": "./dist/frameworks/preact.d.ts",
      "default": "./dist/frameworks/preact.js"
    },
    "./qwik": {
      "types": "./dist/frameworks/qwik.d.ts",
      "default": "./dist/frameworks/qwik.js"
    },
    "./react": {
      "types": "./dist/frameworks/react.d.ts",
      "default": "./dist/frameworks/react.js"
    },
    "./solid": {
      "types": "./dist/frameworks/solid.d.ts",
      "default": "./dist/frameworks/solid.js"
    },
    "./svelte": {
      "types": "./dist/frameworks/svelte.d.ts",
      "default": "./dist/frameworks/svelte.js"
    },
    "./vanilla": {
      "types": "./dist/frameworks/vanilla.d.ts",
      "default": "./dist/frameworks/vanilla.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue.d.ts",
      "default": "./dist/frameworks/vue.js"
    },
    "./runtime/class-name-object": {
      "types": "./dist/runtime/class-name-object.d.ts",
      "default": "./dist/runtime/class-name-object.js"
    },
    "./runtime/class-name-object-development": {
      "types": "./dist/runtime/class-name-object-development.d.ts",
      "default": "./dist/runtime/class-name-object-development.js"
    },
    "./runtime/class-object": {
      "types": "./dist/runtime/class-object.d.ts",
      "default": "./dist/runtime/class-object.js"
    },
    "./runtime/class-object-development": {
      "types": "./dist/runtime/class-object-development.d.ts",
      "default": "./dist/runtime/class-object-development.js"
    },
    "./runtime/class-string": {
      "types": "./dist/runtime/class-string.d.ts",
      "default": "./dist/runtime/class-string.js"
    },
    "./runtime/class-string-development": {
      "types": "./dist/runtime/class-string-development.d.ts",
      "default": "./dist/runtime/class-string-development.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@stillwind/config": "workspace:*",
    "@stillwind/native": "workspace:*",
    "@stillwind/projection": "workspace:*"
  },
  "devDependencies": {
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "lit": "^3.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  }
}
