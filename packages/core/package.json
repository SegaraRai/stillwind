{
  "name": "stillwind",
  "version": "0.0.0",
  "description": "CSS definitions and framework adapters for Stillwind",
  "license": "MIT",
  "files": [
    "dist",
    "index.css",
    "css"
  ],
  "type": "module",
  "exports": {
    ".": "./index.css",
    "./builtins.css": "./css/builtins.css",
    "./preflight.css": "./css/preflight.css",
    "./theme.css": "./css/theme.css",
    "./utilities.css": "./css/utilities.css",
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/css.js"
    },
    "./module-css": {
      "types": "./dist/module-css.d.ts",
      "default": "./dist/module-css.js"
    },
    "./macro": {
      "types": "./dist/macro/index.d.ts",
      "default": "./dist/macro/index.js"
    },
    "./react": {
      "types": "./dist/frameworks/react.d.ts",
      "default": "./dist/frameworks/react.js"
    },
    "./react/runtime": {
      "types": "./dist/runtime/react.d.ts",
      "default": "./dist/runtime/react.js"
    },
    "./runtime/dev": {
      "types": "./dist/runtime/dev.d.ts",
      "default": "./dist/runtime/dev.js"
    },
    "./preact": {
      "types": "./dist/frameworks/preact.d.ts",
      "default": "./dist/frameworks/preact.js"
    },
    "./preact/runtime": {
      "types": "./dist/runtime/preact.d.ts",
      "default": "./dist/runtime/preact.js"
    },
    "./vue/runtime": {
      "types": "./dist/runtime/vue.d.ts",
      "default": "./dist/runtime/vue.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue.d.ts",
      "default": "./dist/frameworks/vue.js"
    },
    "./svelte/runtime": {
      "types": "./dist/runtime/svelte.d.ts",
      "default": "./dist/runtime/svelte.js"
    },
    "./svelte": {
      "types": "./dist/frameworks/svelte.d.ts",
      "default": "./dist/frameworks/svelte.js"
    },
    "./astro/runtime": {
      "types": "./dist/runtime/astro.d.ts",
      "default": "./dist/runtime/astro.js"
    },
    "./astro": {
      "types": "./dist/frameworks/astro.d.ts",
      "default": "./dist/frameworks/astro.js"
    },
    "./solid": {
      "types": "./dist/frameworks/solid.d.ts",
      "default": "./dist/frameworks/solid.js"
    },
    "./solid/runtime": {
      "types": "./dist/runtime/solid.d.ts",
      "default": "./dist/runtime/solid.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@stillwind/native": "workspace:*",
    "@stillwind/projection": "workspace:*"
  },
  "devDependencies": {
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
