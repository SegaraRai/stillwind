{
  "name": "@stillwind/language-server",
  "version": "0.1.0-rc.0",
  "description": "Stillwind language server for Node and browser transports",
  "homepage": "https://stillwind.dev/",
  "bugs": {
    "url": "https://github.com/SegaraRai/stillwind/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegaraRai/stillwind.git",
    "directory": "packages/language-server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stillwind/analysis": "workspace:*",
    "@stillwind/native": "workspace:*",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "devDependencies": {
    "@stillwind-internal/tools-workspace": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "stillwind": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
