#!/usr/bin/env sh
set -eu

files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$files" ]; then
  exit 0
fi

vp fmt --no-error-on-unmatched-pattern $files

if ! git diff --quiet -- $files; then
  echo "vp fmt changed files; stage the formatting changes and commit again."
  exit 1
fi

vp lint --no-error-on-unmatched-pattern $files
cargo fmt --check
cargo clippy --workspace --all-targets -- -D warnings
