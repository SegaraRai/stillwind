{
  "extends": ["astro/tsconfigs/strict", "../../tsconfig.strict.json"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": [".astro/types.d.ts", "src", "build", "*.ts"],
  "exclude": ["dist"]
}
