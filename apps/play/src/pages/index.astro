---
import { style } from "stillwind/astro";

import Playground from "../Playground.tsx";

import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";

const title = "Stillwind Playground";
const description =
  "Write React components with Stillwind utilities in your browser, and inspect the generated CSS, compiled code, and diagnostics as you type.";
const canonical = new URL(import.meta.env.BASE_URL, Astro.site).href;
const image = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stillwind" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script is:inline>
      try {
        const preference = localStorage.getItem("stillwind:theme");
        if (preference === "light" || preference === "dark") {
          document.documentElement.dataset.theme = preference;
        }
      } catch {}
    </script>
  </head>
  <body>
    <Playground client:only="react" />
    <noscript>
      <p {...style("p-4 text-small")}>
        {title} runs the Stillwind compiler, the editor, and the preview in your browser. Enable
        JavaScript to use it.
      </p>
    </noscript>
  </body>
</html>
