---
import { style } from "stillwind/astro";

import Showcase from "../components/Showcase.astro";

const repository = "https://github.com/SegaraRai/stillwind";
const docs = `${repository}#configure-an-application`;
const integrations = `${repository}/blob/main/packages/integration/README.md`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content="Familiar utilities. Enforced rules. Stillwind checks component styles against your design system and compiles static utilities to CSS."
    />
    <meta name="theme-color" content="#f4f4f2" />
    <title>Stillwind — Familiar utilities. Enforced rules.</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body {...style("font-sans text-ink antialiased bg-paper")}>
    <a href="#main" {...style("skip-link")}>Skip to content</a>
    <div {...style("site-shell")}>
      <header
        {...style(
          "flex py-7 items-center justify-between gap-3 border-rule border-be sm:gap-6",
        )}
      >
        <a
          href="/"
          aria-label="Stillwind home"
          {...style("text-[29px] tracking-tighter nav-link")}>Stillwind</a
        >
        <nav
          aria-label="Main navigation"
          {...style("flex gap-3 text-xs sm:gap-9 sm:text-sm")}
        >
          <a href={docs} {...style("nav-link")}>Docs</a>
          <a href="#examples" {...style("nav-link")}>Examples</a>
          <a href={repository} {...style("nav-link")}
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </nav>
      </header>

      <main id="main">
        <section
          aria-labelledby="tagline"
          {...style("pbs-16 pbe-16 md:pbs-20 md:pbe-20")}
        >
          <h1 id="tagline" {...style("hero-title")}>
            Familiar utilities.
            <span {...style("hero-second-line")}>Enforced rules.</span>
          </h1>
          <div
            {...style(
              "flex mbs-10 flex-col justify-between gap-9 md:mbs-12 md:flex-row md:items-end",
            )}
          >
            <div>
              <p
                {...style(
                  "max-inline-117.5 text-lg/[1.55] text-muted md:text-xl/[1.55]",
                )}
              >
                Write compact utilities. Catch mistakes, enforce your design
                system, and compile to static CSS.
              </p>
              <div {...style("flex mbs-7 flex-wrap items-center gap-7")}>
                <a
                  href={docs}
                  {...style("text-paper bg-ink action-link hover:bg-soft-ink")}
                  >Get started <span aria-hidden="true">↗</span></a
                >
                <a href="#examples" {...style("text-sm nav-link")}
                  >See it in practice <span
                    aria-hidden="true"
                    {...style("ms-3")}>↓</span
                  ></a
                >
              </div>
            </div>
            <p
              {...style(
                "max-inline-57.5 font-mono text-[11px] text-muted leading-[1.7]",
              )}
            >
              For people who write code.<br />
              And agents that write a lot of it.
              <!-- このキャッチコピーは良い -->
            </p>
          </div>
        </section>

        <Showcase />

        <section
          aria-labelledby="principles"
          {...style("pbs-14 pbe-16 border-rule border-bs md:pbs-20 md:pbe-24")}
        >
          <div
            {...style("flex mbe-12 flex-col justify-between gap-6 md:flex-row")}
          >
            <p {...style("font-mono text-[11px] text-muted")}>
              THE WAY WE WRITE CSS
              <!-- ここはなんか別のに置き換える。テキストでなくベクタ背景画像でもいいかも。 -->
            </p>
            <h2
              id="principles"
              {...style(
                "max-inline-162.5 text-[32px] leading-[1.1] tracking-[-0.04em] md:text-[45px]",
              )}
            >
              More code shouldn’t mean<br /> less confidence.
              <!-- このキャッチコピーも良い -->
            </h2>
          </div>
          <div {...style("grid gap-9 md:grid-cols-3 md:gap-14")}>
            <div {...style("pbs-5 border-rule border-bs")}>
              <p {...style("mbe-7 font-mono text-[10px] text-muted")}>
                01 — FAMILIAR
              </p>
              <h3 {...style("mbe-3 text-lg tracking-tight")}>
                Short syntax. Clear intent.
              </h3>
              <p {...style("max-inline-85 text-muted text-sm/relaxed")}>
                Use the utility vocabulary you already know. Keep styling close
                to the component, without expanding every declaration into
                another line of code.
              </p>
            </div>
            <div {...style("pbs-5 border-rule border-bs")}>
              <p {...style("mbe-7 font-mono text-[10px] text-muted")}>
                02 — ENFORCED
              </p>
              <h3 {...style("mbe-3 text-lg tracking-tight")}>
                Standards that actually run.
              </h3>
              <p {...style("max-inline-85 text-muted text-sm/relaxed")}>
                Turn conventions into lint rules. Check utilities, restrict
                arbitrary values, and share the same policy across editors,
                agents, and CI.
              </p>
            </div>
            <div {...style("pbs-5 border-rule border-bs")}>
              <p {...style("mbe-7 font-mono text-[10px] text-muted")}>
                03 — INSPECTABLE
              </p>
              <h3 {...style("mbe-3 text-lg tracking-tight")}>
                A build you can look into.
              </h3>
              <p {...style("max-inline-85 text-muted text-sm/relaxed")}>
                Static utilities become CSS and framework props. Conditions and
                dynamic values keep the runtime operations they need.
              </p>
            </div>
          </div>
        </section>

        <section
          aria-labelledby="start"
          {...style(
            "flex py-12 flex-col justify-between gap-10 border-rule border-bs md:py-16 md:flex-row md:items-end",
          )}
        >
          <div>
            <p {...style("mbe-5 font-mono text-[11px] text-muted")}>
              EARLY, AND OPEN
            </p>
            <h2
              id="start"
              {...style("mbe-5 text-[34px] tracking-[-0.04em] md:text-[48px]")}
            >
              Bring your own framework.
            </h2>
            <p {...style("max-inline-122.5 text-muted text-sm/relaxed")}>
              Stillwind is in pre-alpha. Explore the source, try an integration,
              and help shape what comes next.
            </p>
            <a
              href={integrations}
              {...style(
                "inline-block mbs-6 font-mono text-[11px] text-muted nav-link",
              )}
              >Astro · React · Vue · Svelte · Solid · Preact <span
                aria-hidden="true">↗</span
              ></a
            >
          </div>
          <a href={repository} {...style("border border-ink action-link")}
            >Explore on GitHub <span aria-hidden="true">↗</span></a
          >
        </section>
      </main>

      <footer
        {...style(
          "flex py-6 flex-wrap justify-between gap-4 font-mono text-[10px] text-muted border-rule border-bs",
        )}
      >
        <span>Stillwind · Open source · MIT</span>
      </footer>
    </div>
  </body>
</html>
