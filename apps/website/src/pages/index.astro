---
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import instrumentSans from "@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url";
import { style } from "stillwind/astro";

import "../assets/fonts/jetbrains-mono.css";
import jetbrainsMono from "../assets/fonts/jetbrains-mono-regular.woff2?url";
import Features from "../components/landing/Features.astro";
import Showcase from "../components/landing/Showcase.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import ThemeHead from "../components/site/ThemeHead.astro";

const repository = "https://github.com/SegaraRai/stillwind";
const docs = "/docs/";
const integrations = "/docs/frameworks/";
const frameworks = ["React", "Vue", "Svelte", "Astro", "Solid", "Preact"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    <meta
      name="description"
      content="Familiar utilities. Enforced rules. Stillwind checks component styles against your design system and compiles static utilities to CSS."
    />
    <title>Stillwind — Familiar utilities. Enforced rules.</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={instrumentSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMono} as="font" type="font/woff2" crossorigin />
  </head>
  <body {...style("font-sans text-body text-foreground antialiased bg-background")}>
    <a href="#main" {...style("skip-link")}>
      Skip to content
    </a>
    <div {...style("landing-shell")}>
      <SiteHeader docs={docs} repository={repository} />

      <main id="main">
        <section aria-labelledby="tagline" {...style("py-16 sidebar:py-28")}>
          <h1 id="tagline" {...style("hero-title")}>
            Familiar utilities.
            <span {...style("hero-second-line")}>Enforced rules.</span>
          </h1>
          <div
            {...style(
              "flex mbs-10 flex-col justify-between gap-9 sidebar:mbs-12 sidebar:flex-row sidebar:items-end",
            )}
          >
            <div>
              <p
                {...style(
                  "max-inline-117.5 text-body/[1.55] text-muted inline:text-lead/[1.55] sidebar:text-heading-small/[1.55]",
                )}
              >
                A compiler for component styles. Write familiar utilities, enforce your design
                system, and ship static CSS.
              </p>
              <div {...style("flex mbs-7 flex-wrap items-center gap-7")}>
                <a
                  href={docs}
                  {...style("text-action-foreground bg-action action-link hover:bg-action-hover")}
                >
                  Get started <span aria-hidden="true">↗</span>
                </a>
                <a href="#examples" {...style("text-small nav-link")}>
                  See it in practice{" "}
                  <span aria-hidden="true" {...style("ms-3")}>
                    ↓
                  </span>
                </a>
              </div>
            </div>
            <p {...style("max-inline-64 font-mono text-caption text-muted leading-[1.7]")}>
              For people who write code.
              <br />
              And agents that write a lot of it.
              <!-- このキャッチコピーは良い -->
            </p>
          </div>
        </section>

        <Showcase />
        <Features />

        <section aria-labelledby="start" {...style("py-16 border-border border-bs sidebar:py-32")}>
          <div {...style("flex flex-col justify-between gap-8 sidebar:flex-row sidebar:items-end")}>
            <div>
              <h2 id="start" {...style("mbe-5 text-title tracking-[-0.04em] sidebar:text-title")}>
                Start with your framework.
              </h2>
              <p {...style("max-inline-122.5 text-muted text-small/relaxed")}>
                Keep the component model you know. Add Stillwind to your build and import the style
                API for your framework. Currently in pre-alpha.
              </p>
            </div>
            <a
              href={docs}
              {...style(
                "shrink-0 text-action-foreground bg-action action-link hover:bg-action-hover",
              )}
            >
              Read the setup guide <span aria-hidden="true">↗</span>
            </a>
          </div>
          <nav
            aria-label="Framework integration guides"
            {...style(
              "grid my-10 grid-cols-2 gap-x-7 gap-y-6 inline:grid-cols-3 outline:grid-cols-6",
            )}
          >
            {frameworks.map((framework) => (
              <a
                href={`${integrations}#${framework === "Astro" ? "astro" : "vite"}`}
                {...style("block pbs-4 border-border border-bs nav-link")}
              >
                <span {...style("flex items-center justify-between text-small")}>
                  {framework}
                  <span aria-hidden="true" {...style("text-muted")}>
                    ↗
                  </span>
                </span>
                <span {...style("block mbs-2 font-mono text-muted text-label")}>
                  stillwind/{framework.toLowerCase()}
                </span>
              </a>
            ))}
          </nav>
          <div {...style("grid gap-7 sidebar:grid-cols-3 sidebar:gap-12")}>
            <div>
              <h3 {...style("mbe-2 text-small")}>Tailwind CSS compatibility</h3>
              <p {...style("text-muted text-caption/relaxed")}>
                Use Tailwind CSS v4 utilities, theme variables, and CSS directives. See the{" "}
                <a href="/docs/guides/migrating-from-tailwind/" {...style("nav-link")}>
                  migration guide ↗
                </a>{" "}
                for configuration and plugin compatibility.
              </p>
            </div>
            <div>
              <h3 {...style("mbe-2 text-small")}>Room for existing patterns</h3>
              <p {...style("text-muted text-caption/relaxed")}>
                Utility strings, arrays, and conditions fit existing components.{" "}
                <a href="/docs/macros/cva/" {...style("nav-link")}>
                  CVA-compatible factories ↗
                </a>{" "}
                are available when you need them.
              </p>
            </div>
            <div>
              <h3 {...style("mbe-2 text-small")}>CSS for Web Components</h3>
              <p {...style("text-muted text-caption/relaxed")}>
                Use{" "}
                <a href="/docs/guides/shadow-dom/" {...style("nav-link")}>
                  explicit CSS exports ↗
                </a>{" "}
                to place compiled styles in a Shadow DOM or another scope you control.
              </p>
            </div>
          </div>
        </section>
      </main>

      <footer
        {...style(
          "flex py-6 flex-wrap justify-between gap-4 font-mono text-label text-muted border-border border-bs",
        )}
      >
        <span>Stillwind · Open source · MIT</span>
        <a href={repository} {...style("nav-link")}>
          Explore the source ↗
        </a>
      </footer>
    </div>
    <script>
      import { mountHeader } from "../lib/landing/header";

      const slot = document.querySelector<HTMLElement>("[data-header-slot]");
      const story = document.querySelector<HTMLElement>("[data-story]");
      if (slot && story) {
        mountHeader(slot, story);
      }
    </script>
  </body>
</html>
