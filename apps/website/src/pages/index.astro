---
import { style } from "stillwind/astro";

import Backdrop from "../components/landing/Backdrop.astro";
import Features from "../components/landing/Features.astro";
import Showcase from "../components/landing/Showcase.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import { URL_DOCS } from "../lib/config";

const title = "Stillwind — Familiar utilities. Enforced rules.";
const description =
  "Familiar utilities. Enforced rules. Stillwind checks component styles against your design system and compiles static utilities to CSS.";

const frameworkLink = style.ref();
const frameworks = [
  { name: "React", icon: style("icon-framework icon-simple-icons--react") },
  { name: "Vue", icon: style("icon-framework icon-simple-icons--vuedotjs") },
  { name: "Svelte", icon: style("icon-framework icon-simple-icons--svelte") },
  { name: "Astro", icon: style("icon-framework icon-simple-icons--astro") },
  { name: "Solid", icon: style("icon-framework icon-simple-icons--solid") },
  { name: "Preact", icon: style("icon-framework icon-simple-icons--preact") },
];
---

<HomeLayout title={title} description={description}>
  <Backdrop />

  <section aria-labelledby="tagline" data-backdrop-hero {...style("py-16 sidebar:py-28")}>
    <h1 id="tagline" {...style("hero-title")}>
      Familiar utilities.
      <span {...style("hero-second-line")}>Enforced rules.</span>
    </h1>
    <div
      {...style(
        "flex mbs-10 flex-col justify-between gap-9 sidebar:mbs-12 sidebar:flex-row sidebar:items-end",
      )}
    >
      <div>
        <p
          {...style(
            "max-inline-117.5 text-body/[1.55] text-muted inline:text-lead/[1.55] sidebar:text-heading-small/[1.55]",
          )}
        >
          A compiler for component styles. Write familiar utilities, enforce your design system, and
          ship static CSS.
        </p>
        <div {...style("flex mbs-7 flex-wrap items-center gap-7")}>
          <a
            href={URL_DOCS}
            {...style("text-action-foreground bg-action action-link hover:bg-action-hover")}
          >
            Get started <span aria-hidden="true" {...style("icon-lucide--arrow-right")}></span>
          </a>
          <a href="#examples" {...style("text-small nav-link")}>
            See it in practice{" "}
            <span aria-hidden="true" {...style("icon-lucide--arrow-down ms-3 align-middle")}></span>
          </a>
        </div>
      </div>
      <p {...style("max-inline-64 font-mono text-caption/[1.7] text-muted")}>
        For people who write code.
        <br />
        And agents that write a lot of it.
      </p>
    </div>
  </section>

  <Showcase />
  <Features />

  <section aria-labelledby="start" {...style("py-16 border-border border-bs sidebar:py-32")}>
    <div {...style("flex flex-col justify-between gap-8 sidebar:flex-row sidebar:items-end")}>
      <div>
        <h2 id="start" {...style("mbe-5 text-title tracking-[-0.04em] sidebar:text-title")}>
          Start with your framework.
        </h2>
        <p {...style("max-inline-122.5 text-muted text-small/relaxed")}>
          Keep the component model you know. Add Stillwind to your build and import the style API
          for your framework. Currently in early development.
        </p>
      </div>
      <a
        href={URL_DOCS}
        {...style("shrink-0 text-action-foreground bg-action action-link hover:bg-action-hover")}
      >
        Read the setup guide{" "}
        <span aria-hidden="true" {...style("icon-lucide--arrow-up-right")}></span>
      </a>
    </div>
    <nav
      aria-label="Framework integration guides"
      {...style("grid my-10 grid-cols-2 gap-x-7 gap-y-6 inline:grid-cols-3 outline:grid-cols-6")}
    >
      {frameworks.map((framework) => (
        <a
          href={`/docs/integrations#${framework.name === "Astro" ? "astro" : "vite"}`}
          {...style(frameworkLink, "framework-link")}
        >
          <span
            aria-hidden="true"
            {...style(
              framework.icon,
              "text-muted opacity-70 [transition:color_140ms_ease,opacity_140ms_ease]",
              {
                [frameworkLink("hover")]: "text-foreground opacity-100",
                [frameworkLink("focus-visible")]: "text-foreground opacity-100",
              },
            )}
          ></span>
          <span {...style("flex mbs-5 items-center justify-between text-small")}>
            {framework.name}
            <span aria-hidden="true" {...style("icon-lucide--arrow-up-right text-muted")}></span>
          </span>
          <span {...style("block mbs-2 font-mono text-label text-muted")}>
            stillwind/{framework.name.toLowerCase()}
          </span>
        </a>
      ))}
    </nav>
    <div {...style("grid gap-7 sidebar:grid-cols-3 sidebar:gap-12")}>
      <div>
        <h3 {...style("mbe-2 text-small")}>Tailwind CSS compatibility</h3>
        <p {...style("text-caption/relaxed text-muted")}>
          Use Tailwind CSS v4 utilities, theme variables, and CSS directives. See the{" "}
          <a href="/docs/guides/migrating-from-tailwind" {...style("nav-link")}>
            migration guide{" "}
            <span aria-hidden="true" {...style("icon-lucide--arrow-up-right align-middle")}></span>
          </a>{" "}
          for configuration and plugin compatibility.
        </p>
      </div>
      <div>
        <h3 {...style("mbe-2 text-small")}>Room for existing patterns</h3>
        <p {...style("text-caption/relaxed text-muted")}>
          Utility strings, arrays, and conditions fit existing components.{" "}
          <a href="/docs/macros/cva" {...style("nav-link")}>
            CVA-compatible factories{" "}
            <span aria-hidden="true" {...style("icon-lucide--arrow-up-right align-middle")}></span>
          </a>{" "}
          are available when you need them.
        </p>
      </div>
      <div>
        <h3 {...style("mbe-2 text-small")}>CSS for Web Components</h3>
        <p {...style("text-caption/relaxed text-muted")}>
          Use{" "}
          <a href="/docs/guides/web-components" {...style("nav-link")}>
            explicit CSS exports{" "}
            <span aria-hidden="true" {...style("icon-lucide--arrow-up-right align-middle")}></span>
          </a>{" "}
          to place compiled styles in a Shadow DOM or another scope you control.
        </p>
      </div>
    </div>
  </section>

  <script>
    import { mountHeader } from "../lib/landing/header";

    const slot = document.querySelector<HTMLElement>("[data-header-slot]");
    const story = document.querySelector<HTMLElement>("[data-story]");
    if (slot && story) {
      mountHeader(slot, story);
    }
  </script>
</HomeLayout>
