---
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import type { PrevNext, SidebarItem, TOCItem } from "@cloudflare/nimbus-docs/types";

import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import { style } from "stillwind/astro";

import "../assets/fonts/jetbrains-mono.css";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import ThemeHead from "../components/site/ThemeHead.astro";

interface Props {
  title: string;
  description?: string;
  entryId: string;
  markdownUrl: string;
  sidebar: SidebarItem[];
  headings: TOCItem[];
  editUrl?: string;
  prevNext: PrevNext;
}

const { title, description, entryId, markdownUrl, sidebar, headings, editUrl, prevNext } =
  Astro.props;
const navigationTransition = style.viewTransition({ group: "duration-300 ease-out" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    <NimbusHead
      title={title}
      description={description}
      markdownUrl={markdownUrl}
      collection="docs"
      entryId={entryId}
    />
  </head>
  <body {...style("font-sans text-body text-foreground antialiased bg-background")}>
    <a href="#main-content" {...style("skip-link")}>
      Skip to content
    </a>
    <div {...style("docs-shell")}>
      <SiteHeader docs="/docs/" repository="https://github.com/SegaraRai/stillwind" />
      <div class="docs-grid">
        <nav
          aria-label="Documentation"
          {...style({ class: "docs-navigation" }, navigationTransition.for("docs-navigation"))}
        >
          <DocsSidebar items={sidebar} />
          <div class="docs-agent-links">
            <p class="docs-label">For agents</p>
            <a href="/docs/llms.txt">Documentation index ↗</a>
            <a href="/llms-full.txt">Full documentation ↗</a>
          </div>
          <script is:inline>
            // Restores the open groups and the scroll position from the previous documentation page
            // before the first paint. Groups that contain the current page stay open.
            (() => {
              const key = "stillwind:docs-sidebar";
              const nav = document.currentScript.parentElement;
              const groups = () => nav.querySelectorAll("details[data-sidebar-group]");
              try {
                const state = JSON.parse(sessionStorage.getItem(key) ?? "null");
                if (state) {
                  for (const group of groups()) {
                    if (!group.querySelector('[aria-current="page"]')) {
                      group.open = state.open.includes(group.dataset.sidebarGroup);
                    }
                  }
                  nav.scrollTop = state.scrollTop;
                }
              } catch {}
              addEventListener("pagehide", () => {
                try {
                  const open = [...groups()].filter((group) => group.open);
                  sessionStorage.setItem(
                    key,
                    JSON.stringify({
                      open: open.map((group) => group.dataset.sidebarGroup),
                      scrollTop: nav.scrollTop,
                    }),
                  );
                } catch {}
              });
            })();
          </script>
        </nav>
        <main id="main-content" class="docs-main">
          <header class="docs-page-header">
            <h1>{title}</h1>
            {description && <p class="docs-description">{description}</p>}
            <div class="docs-page-actions">
              <a href={markdownUrl}>View as Markdown ↗</a>
              <button type="button" data-copy-markdown={markdownUrl} hidden>
                Copy page
              </button>
              <span role="status" data-copy-status></span>
            </div>
          </header>
          <article class="docs-prose" data-pagefind-body>
            <slot />
          </article>
          <footer class="docs-footer">
            {(prevNext.prev || prevNext.next) && (
              <nav class="docs-pagination" aria-label="Documentation pages">
                {prevNext.prev && (
                  <a
                    class="docs-pagination-prev"
                    href={prevNext.prev.href}
                    rel="prev"
                    aria-label={`Previous page: ${prevNext.prev.label}`}
                  >
                    <span aria-hidden="true">←</span>
                    <span>{prevNext.prev.label}</span>
                  </a>
                )}
                {prevNext.next && (
                  <a
                    class="docs-pagination-next"
                    href={prevNext.next.href}
                    rel="next"
                    aria-label={`Next page: ${prevNext.next.label}`}
                  >
                    <span>{prevNext.next.label}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </nav>
            )}
            {editUrl && <a href={editUrl}>Edit this page ↗</a>}
          </footer>
        </main>
        <nav class="docs-toc" aria-label="On this page">
          <ul>
            {headings.map((heading) => (
              <li {...style({ "--heading-depth": heading.depth })}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </body>
</html>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-markdown]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  if (button && status) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      button.disabled = true;
      status.textContent = "";
      try {
        const response = await fetch(button.dataset.copyMarkdown!);
        if (!response.ok) {
          throw new Error(`Markdown request failed: ${response.status}`);
        }
        await navigator.clipboard.writeText(await response.text());
        status.textContent = "Copied.";
      } catch {
        status.textContent = "Could not copy. Open the Markdown link to copy the page.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
