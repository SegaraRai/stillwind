---
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import type { PrevNext, SidebarItem, TOCItem } from "@cloudflare/nimbus-docs/types";

import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import { style } from "stillwind/astro";

import "../assets/fonts/jetbrains-mono.css";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import { documentRoot } from "../components/site/document";
import SiteHeader from "../components/site/SiteHeader.astro";
import ThemeHead from "../components/site/ThemeHead.astro";

interface Props {
  title: string;
  description?: string;
  entryId: string;
  markdownUrl: string;
  sidebar: SidebarItem[];
  headings: TOCItem[];
  editUrl?: string;
  prevNext: PrevNext;
}

const { title, description, entryId, markdownUrl, sidebar, headings, editUrl, prevNext } =
  Astro.props;

const navigationTransition = style.viewTransition({
  group: "duration-300 ease-out",
});
const paginationLink = style(
  "flex py-3 min-inline-0 items-start gap-3 wrap-anywhere hover:text-accent",
);
---

<!doctype html>
<html lang="en" {...style(documentRoot, "site-document")}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    <NimbusHead
      title={title}
      description={description}
      markdownUrl={markdownUrl}
      collection="docs"
      entryId={entryId}
    />
  </head>
  <body {...style("font-sans text-body text-foreground antialiased bg-background")}>
    <a href="#main-content" {...style("skip-link")}>
      Skip to content
    </a>
    <div {...style("mx-auto px-docs-gutter inline-full max-inline-docs")}>
      <SiteHeader />
      <div
        {...style(
          "grid pbs-12 pbe-20 grid-cols-[var(--container-navigation)_minmax(0,1fr)_var(--container-outline)] items-start gap-docs-gutter",
          {
            "max-docs-outline:": "grid-cols-[var(--container-navigation)_minmax(0,1fr)] gap-stack",
            "max-sidebar:": "pbs-6 grid-cols-[minmax(0,1fr)]",
          },
        )}
      >
        <nav
          aria-label="Documentation"
          {...style(
            "docs-navigation",
            navigationTransition.for("docs-navigation"),
            "max-sidebar:static max-sidebar:pbe-6 max-sidebar:max-block-64 max-sidebar:border-border max-sidebar:border-be",
          )}
        >
          <DocsSidebar items={sidebar} />
          <div
            {...style(
              "grid mbs-9 pbs-6 gap-2.5 text-caption border-border border-bs max-sidebar:hidden",
            )}
          >
            <p {...style("font-mono text-label text-muted tracking-[0.08em] uppercase")}>
              For agents
            </p>
            <a
              href="/docs/llms.txt"
              {...style("hover:text-foreground hover:underline hover:underline-offset-4")}
            >
              Documentation index{" "}
              <span
                aria-hidden="true"
                {...style("icon-lucide--arrow-up-right align-middle")}
              ></span>
            </a>
            <a
              href="/llms-full.txt"
              {...style("hover:text-foreground hover:underline hover:underline-offset-4")}
            >
              Full documentation{" "}
              <span
                aria-hidden="true"
                {...style("icon-lucide--arrow-up-right align-middle")}
              ></span>
            </a>
          </div>
          <script is:inline>
            // Restores the open groups and the scroll position from the previous documentation page
            // before the first paint. Groups that contain the current page stay open.
            (() => {
              const key = "stillwind:docs-sidebar";
              const nav = document.currentScript.parentElement;
              const groups = () => nav.querySelectorAll("details[data-sidebar-group]");
              try {
                const state = JSON.parse(sessionStorage.getItem(key) ?? "null");
                if (state) {
                  for (const group of groups()) {
                    if (!group.querySelector('[aria-current="page"]')) {
                      group.open = state.open.includes(group.dataset.sidebarGroup);
                    }
                  }
                  nav.scrollTop = state.scrollTop;
                }
              } catch {}
              addEventListener("pagehide", () => {
                try {
                  const open = [...groups()].filter((group) => group.open);
                  sessionStorage.setItem(
                    key,
                    JSON.stringify({
                      open: open.map((group) => group.dataset.sidebarGroup),
                      scrollTop: nav.scrollTop,
                    }),
                  );
                } catch {}
              });
            })();
          </script>
        </nav>
        <main id="main-content" {...style("min-inline-0")}>
          <header {...style("mbe-10")}>
            <h1 {...style("font-display text-title tracking-[-0.045em]")}>{title}</h1>
            {description && <p {...style("mbs-5 text-lead text-muted")}>{description}</p>}
            <div {...style("flex mbs-6 flex-wrap items-center gap-x-5 gap-y-3 text-caption")}>
              <a href={markdownUrl} {...style("underline underline-offset-4")}>
                View as Markdown{" "}
                <span
                  aria-hidden="true"
                  {...style("icon-lucide--arrow-up-right align-middle")}
                ></span>
              </a>
              <button
                type="button"
                data-copy-markdown={markdownUrl}
                hidden
                {...style("underline underline-offset-4 cursor-pointer")}
              >
                Copy page
              </button>
              <span role="status" data-copy-status {...style("text-muted")}></span>
            </div>
          </header>
          <article {...style("docs-prose")} data-pagefind-body>
            <slot />
          </article>
          <footer
            {...style("grid mbs-16 pbs-6 gap-6 text-caption text-muted border-border border-bs")}
          >
            {(prevNext.prev || prevNext.next) && (
              <nav
                aria-label="Documentation pages"
                {...style("grid grid-cols-2 gap-6 text-foreground text-ui font-medium")}
              >
                {prevNext.prev && (
                  <a
                    {...style(paginationLink, "col-start-1")}
                    href={prevNext.prev.href}
                    rel="prev"
                    aria-label={`Previous page: ${prevNext.prev.label}`}
                  >
                    <span
                      aria-hidden="true"
                      {...style("icon-lucide--arrow-left mbs-1 shrink-0")}
                    ></span>
                    <span>{prevNext.prev.label}</span>
                  </a>
                )}
                {prevNext.next && (
                  <a
                    {...style(paginationLink, "col-start-2 justify-end text-end")}
                    href={prevNext.next.href}
                    rel="next"
                    aria-label={`Next page: ${prevNext.next.label}`}
                  >
                    <span>{prevNext.next.label}</span>
                    <span
                      aria-hidden="true"
                      {...style("icon-lucide--arrow-right mbs-1 shrink-0")}
                    ></span>
                  </a>
                )}
              </nav>
            )}
            {editUrl && (
              <a href={editUrl} {...style("justify-self-start")}>
                Edit this page{" "}
                <span
                  aria-hidden="true"
                  {...style("icon-simple-icons--github align-middle")}
                ></span>
              </a>
            )}
          </footer>
        </main>
        <nav {...style("docs-navigation", "max-docs-outline:hidden")} aria-label="On this page">
          <ul {...style("grid p-0 gap-1.5 list-none")}>
            {headings.map((heading) => (
              <li
                {...style("ps-[calc((var(--heading-depth)-2)*10px)]", {
                  "--heading-depth": heading.depth,
                })}
              >
                <a
                  href={`#${heading.slug}`}
                  {...style(
                    "block py-1 text-muted hover:text-foreground hover:underline hover:underline-offset-4",
                  )}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </body>
</html>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-markdown]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  if (button && status) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      button.disabled = true;
      status.textContent = "";
      try {
        const response = await fetch(button.dataset.copyMarkdown!);
        if (!response.ok) {
          throw new Error(`Markdown request failed: ${response.status}`);
        }
        await navigator.clipboard.writeText(await response.text());
        status.textContent = "Copied.";
      } catch {
        status.textContent = "Could not copy. Open the Markdown link to copy the page.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
