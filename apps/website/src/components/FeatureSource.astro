---
import FeaturePreview from "./FeaturePreview.astro";

interface Props {
  topic: number;
  frames: readonly {
    source: string;
    focus: string;
    label: string;
    description: string;
  }[];
}

const { topic, frames } = Astro.props;

const tokenize = (source: string, frame: number) => {
  const counts = new Map<string, number>();
  return [
    ...source.matchAll(/"(?:[^"\\]|\\.)*"|[a-zA-Z_$][\w$]*|\d+|\s+|./g),
  ].map((match) => {
    const text = match[0];
    const punctuation = !text.startsWith('"') && !/^[\w$\s]/.test(text);
    const count = counts.get(text) ?? 0;
    counts.set(text, count + 1);
    return {
      text,
      punctuation,
      key:
        (text.startsWith('"') || /^[\w$]/.test(text)
          ? "value-"
          : "syntax-" + frame + "-") +
        text +
        "-" +
        count,
      start: match.index,
    };
  });
};

const specimens = frames.map((frame, index) => {
  const start = frame.source.indexOf(frame.focus);
  if (start < 0) {
    throw new Error("A source connector must identify text in its specimen.");
  }

  const parts = tokenize(frame.source, index);
  const runs: {
    focused: boolean;
    parts: typeof parts;
  }[] = [];
  for (const part of parts) {
    const focused =
      part.start >= start &&
      part.start < start + frame.focus.length &&
      !part.text.includes("\n");
    const previous = runs.at(-1);
    if (previous?.focused === focused) {
      previous.parts.push(part);
    } else {
      runs.push({ focused, parts: [part] });
    }
  }
  return runs;
});
---

<div data-code-actors aria-hidden="true"></div>
<div data-feature-highlights aria-hidden="true"></div>
{
  specimens.map((runs, index) => (
    <div data-feature-example={index} data-current={index === 0 || undefined}>
      <div data-feature-example-heading>
        <p data-example-label>{frames[index].label}</p>
        <p data-example-description>{frames[index].description}</p>
      </div>
      <pre
        data-measure
        data-feature-frame={index}
        data-current={index === 0 || undefined}
      ><code>{runs.map((run) =>
        run.focused ? (
          <mark data-feature-origin>{run.parts.map((part) => (
            <span
              data-part={part.key}
              data-code-punctuation={part.punctuation || undefined}
            >{part.text}</span>
          ))}</mark>
        ) : (
          run.parts.map((part) => (
            <span
              data-part={part.key}
              data-code-punctuation={part.punctuation || undefined}
            >{part.text}</span>
          ))
        ),
      )}</code></pre>
      <FeaturePreview topic={topic} frame={index} />
    </div>
  ))
}
