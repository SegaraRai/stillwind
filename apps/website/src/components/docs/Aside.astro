---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"aside"> {
  type?: "note" | "tip" | "caution" | "danger";
  title?: string;
}

const { type = "note", title, class: className, ...attributes } = Astro.props;
const variants = {
  note: { label: "Note", icon: "M12 8h.01M12 11v5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
  tip: {
    label: "Tip",
    icon: "M9 18h6M10 21h4M9 15a6 6 0 1 1 6 0v3H9v-3Z",
  },
  caution: { label: "Caution", icon: "M12 9v4m0 3h.01M12 3 2 21h20L12 3Z" },
  danger: { label: "Danger", icon: "M12 7v6m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
};
const variant = variants[type] ?? variants.note;
const displayTitle = title ?? variant.label;
---

<aside
  role="note"
  aria-label={displayTitle}
  data-aside-type={type}
  class:list={["docs-aside", className]}
  {...attributes}
>
  <svg class="docs-aside-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d={variant.icon}></path>
  </svg>
  <div class="docs-aside-content">
    <p class="docs-aside-title">{displayTitle}</p>
    <div class="docs-aside-body">
      <slot />
    </div>
  </div>
</aside>
