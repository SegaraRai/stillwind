---
import type { HTMLAttributes } from "astro/types";
import { style } from "stillwind/astro";

interface Props extends HTMLAttributes<"aside"> {
  type?: "note" | "tip" | "caution" | "danger";
  title?: string;
}

const { type = "note", title, class: className, ...attributes } = Astro.props;
const variants = {
  note: { label: "Note", icon: style("icon-aside icon-lucide--info") },
  tip: {
    label: "Tip",
    icon: style("icon-aside icon-lucide--lightbulb"),
  },
  caution: { label: "Caution", icon: style("icon-aside icon-lucide--triangle-alert") },
  danger: { label: "Danger", icon: style("icon-aside icon-lucide--circle-alert") },
};
const variant = variants[type] ?? variants.note;
const displayTitle = title ?? variant.label;
---

<aside
  role="note"
  aria-label={displayTitle}
  data-aside-type={type}
  {...attributes}
  {...style(
    "flex p-4 items-start gap-control text-accent bg-accent/5 rounded-panel border border-accent/30",
    {
      "data-[aside-type=tip]:": "text-success bg-success/5 border-success/30",
      "data-[aside-type=caution]:": "text-warning bg-warning/5 border-warning/30",
      "data-[aside-type=danger]:": "text-danger bg-danger/5 border-danger/30",
      class: className,
    },
  )}
>
  <span {...style(variant.icon, "mbs-1 shrink-0")} aria-hidden="true"></span>
  <div {...style("min-inline-0 flex-1")}>
    <p {...style("mbe-2 text-body font-semibold")}>{displayTitle}</p>
    <div {...style("text-foreground text-small aside-body")}>
      <slot />
    </div>
  </div>
</aside>
