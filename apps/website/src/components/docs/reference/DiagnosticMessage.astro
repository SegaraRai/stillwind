---
import { style } from "stillwind/astro";

import type { ExampleDiagnostic } from "./diagnostic-example";

interface Props {
  diagnostic: ExampleDiagnostic;
}

const { diagnostic } = Astro.props;
---

<div {...style("p-4 text-danger text-small bg-danger/5 rounded-control border-danger border-s-2")}>
  <p>
    <strong>{diagnostic.code}</strong>: {diagnostic.message}
  </p>
  {diagnostic.notes.map((note) => (
    <p {...style("mbs-2")}>{note}</p>
  ))}
</div>
