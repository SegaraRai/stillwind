---
import { Code } from "astro:components";
import { style } from "stillwind/astro";

import { compileExample, noCssMessage } from "./compiled-example";

interface Props {
  source: string;
}

const example = await compileExample(Astro.props.source);

const theme = {
  light: "github-light",
  dark: "github-dark",
} as const;
---

<div {...style("compiled-example")}>
  <h3>Source</h3>
  <Code code={example.source.trim()} lang="tsx" themes={theme} defaultColor={false} />
  <h3>Compiled code</h3>
  <Code code={example.code.trim()} lang="ts" themes={theme} defaultColor={false} />
  <h3>Generated CSS</h3>
  {example.css ? (
    <Code code={example.css.trim()} lang="css" themes={theme} defaultColor={false} />
  ) : (
    <p>{noCssMessage}</p>
  )}
</div>
