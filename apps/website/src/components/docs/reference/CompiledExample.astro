---
import { Code } from "astro:components";
import { style } from "stillwind/astro";

import { compileExample, documentCssHeading, noCssMessage } from "./compiled-example";

interface Props {
  source?: string;
  stylesheet?: string;
  /** Leaves out the generated stylesheet, such as for `style.css()` examples. */
  hideCss?: boolean;
}

const { hideCss } = Astro.props;

const example = await compileExample(Astro.props);

const theme = {
  light: "github-light",
  dark: "github-dark",
} as const;
---

<div {...style("compiled-example")}>
  {example.stylesheet !== undefined && (
    <>
      <h3>Stylesheet</h3>
      <Code code={example.stylesheet.trim()} lang="css" themes={theme} defaultColor={false} />
    </>
  )}
  {example.source !== undefined && (
    <>
      <h3>Source</h3>
      <Code code={example.source.trim()} lang="tsx" themes={theme} defaultColor={false} />
      <h3>Compiled code</h3>
      <Code code={example.code!.trim()} lang="ts" themes={theme} defaultColor={false} />
    </>
  )}
  {!hideCss && <h3>{example.stylesheet === undefined ? "Generated CSS" : documentCssHeading}</h3>}
  {hideCss ? null : example.css ? (
    <Code code={example.css} lang="css" themes={theme} defaultColor={false} />
  ) : (
    <p>{noCssMessage}</p>
  )}
</div>
