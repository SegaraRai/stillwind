---
import { style } from "stillwind/astro";
---

<dialog
  data-search-dialog
  aria-label="Search documentation"
  {...style(
    "hidden mx-auto mbs-[12dvh] p-0 inline-[min(40rem,calc(100%-2rem))] max-block-[min(36rem,76dvh)] flex-col text-foreground bg-surface rounded-panel border border-border shadow-lg open:flex backdrop:bg-foreground/30",
  )}
>
  <div {...style("flex items-center gap-3 px-4 border-border border-be")}>
    <span
      aria-hidden="true"
      {...style("icon-control icon-lucide--search shrink-0 text-muted")}
    ></span>
    <input
      data-search-input
      type="text"
      role="combobox"
      aria-label="Search documentation"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
      placeholder="Search documentation"
      autocomplete="off"
      spellcheck="false"
      {...style(
        "block-12 min-inline-0 flex-1 text-small text-foreground bg-transparent outline-none placeholder:text-muted",
      )}
    />
    <form method="dialog">
      <button
        aria-label="Close search"
        {...style(
          "px-1.5 py-0.5 font-mono text-label text-muted rounded-inline border border-border cursor-pointer hover:text-foreground",
        )}
      >
        Esc
      </button>
    </form>
  </div>
  <div {...style("min-block-40 overflow-y-auto p-2")}>
    <p data-search-status role="status" {...style("py-8 text-center text-small text-muted")}>
      Type to search the documentation.
    </p>
    <div data-search-results id="search-results" role="listbox" aria-label="Results" hidden></div>
  </div>
</dialog>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client";

  import { bindSearchShortcuts, mountSearchDialog } from "../../lib/docs/search/dialog";

  bindSearchShortcuts(document);
  mount("[data-search-dialog]", (dialog) => mountSearchDialog(dialog as HTMLDialogElement));
</script>
