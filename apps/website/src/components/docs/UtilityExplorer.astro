---
import { style } from "stillwind/astro";

import { documentationCompiler } from "../../lib/docs/reference/compiler";
import { highlightCss } from "../../lib/docs/utilities/highlight";
import { lookupUtilities, matchCaption } from "../../lib/docs/utilities/lookup";

const initial = "p-4";
const examples = [
  "p-4",
  "p-[16px]",
  "display: flex",
  "background-color: #3b82f6",
  "hover:underline",
];
const { matches } = lookupUtilities((await documentationCompiler()).query, initial);
const control = style(
  "px-control block-11 inline-full min-inline-0 font-normal text-foreground bg-background rounded-control border border-border",
);
---

<div {...style("grid gap-5")} data-utility-explorer>
  <form
    role="search"
    aria-label="Utility lookup"
    {...style("grid p-panel gap-control bg-surface rounded-panel border border-border")}
  >
    <label for="utility-query" {...style("text-ui font-medium")}>
      Utility or CSS
    </label>
    <input
      id="utility-query"
      name="q"
      type="search"
      value={initial}
      placeholder="p-4 or display: flex"
      autocomplete="off"
      spellcheck="false"
      {...style(control, "font-mono")}
    />
    <div {...style("flex flex-wrap items-center gap-2 text-caption text-muted")}>
      <span>Try</span>
      {examples.map((example) => (
        <button
          type="button"
          data-example={example}
          {...style(
            "px-2 py-0.5 font-mono text-foreground bg-background rounded-inline border border-border cursor-pointer hover:bg-surface-muted",
          )}
        >
          {example}
        </button>
      ))}
    </div>
  </form>
  <p role="status" aria-live="polite" {...style("text-caption text-muted")}>
    Enable JavaScript to look up other utilities. The results show an example.
  </p>
  <div data-utility-results {...style("grid gap-5")}>
    {matches.map((match) => (
      <section {...style("utility-result")}>
        <div {...style("utility-result-header")}>
          <h3 {...style("utility-result-title")}>
            <code>{match.utility}</code>
          </h3>
          {matchCaption(match) && <p {...style("utility-result-caption")}>{matchCaption(match)}</p>}
        </div>
        <pre
          {...style("utility-result-code")}
        >{match.css ? <code set:html={highlightCss(match.css)} /> : <code>Adds a marker class and no declarations.</code>}</pre>
      </section>
    ))}
  </div>
</div>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client";

  import { mountUtilityExplorer } from "../../lib/docs/utilities/explorer";

  mount("[data-utility-explorer]", mountUtilityExplorer);
</script>
