---
import { getEntry } from "astro:content";
import { style } from "stillwind/astro";

import type { UtilityCatalog } from "../../lib/docs/utilities/search";

const catalog: UtilityCatalog = (await getEntry("utilities", "default"))!.data;
const examples = ["p-4", "flex", "text-center", "bg-blue-500"].map((name) =>
  catalog.records.find((record) => record.name === name)!,
);
const metadata = style("text-caption text-muted");
const field = style("grid min-inline-0 gap-2 text-ui font-medium");
const control = style(
  "px-3 block-11 inline-full min-inline-0 font-normal text-foreground bg-background rounded-control border border-border",
);
---

<div {...style("grid gap-5")} data-utility-explorer data-catalog="/docs/utilities/catalog.json">
  <p {...metadata}>
    Stillwind {catalog.version} · {catalog.records.length.toLocaleString("en")} built-in spellings ·
    Default theme
  </p>
  <form
    role="search"
    aria-label="Built-in utility search"
    {...style(
      "grid p-panel grid-cols-[minmax(0,1fr)] items-end gap-control bg-surface rounded-panel border border-border sidebar:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)_auto]",
    )}
  >
    <div {...field}>
      <label for="utility-mode">Search direction</label>
      <select id="utility-mode" name="mode" {...control}>
        <option value="utility">Utility to CSS</option>
        <option value="css">CSS to utilities</option>
      </select>
    </div>
    <div {...field}>
      <label for="utility-query">Utility or CSS terms</label>
      <input
        id="utility-query"
        name="q"
        type="search"
        value="p-4"
        placeholder="p-4 or display: flex"
        autocomplete="off"
        {...control}
      />
    </div>
    <button
      type="submit"
      {...style(
        "px-4 block-11 text-action-foreground text-ui font-medium bg-action rounded-control cursor-pointer hover:bg-action-hover",
      )}
    >
      Search
    </button>
  </form>
  <p role="status" aria-live="polite" {...metadata}>
    Enable JavaScript to search. Representative examples follow.
  </p>
  <div data-utility-results {...style("grid gap-5")}>
    {examples.map((record) => (
      <section {...style("utility-result")}>
        <h3 {...style("utility-result-title")}>
          <code>{record.name}</code>
        </h3>
        <pre {...style("utility-result-code")}><code>{record.css}</code></pre>
      </section>
    ))}
  </div>
  <p {...metadata}>
    Catalog revision <code>{catalog.revision.slice(0, 12)}</code>.{" "}
    <a href="/docs/utilities/index.md">
      Full catalog as Markdown{" "}
      <span aria-hidden="true" {...style("icon-lucide--arrow-up-right align-middle")}></span>
    </a>
  </p>
</div>

<script>
  import { mountUtilityExplorer } from "../../lib/docs/utilities/explorer";

  const root = document.querySelector<HTMLElement>("[data-utility-explorer]");
  if (root) {
    void mountUtilityExplorer(root);
  }
</script>
