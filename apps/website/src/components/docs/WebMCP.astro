---
/**
 * Registers a `search_documentation` tool for browser agents that support WebMCP. The tool
 * searches the same Pagefind index as the search dialog.
 */

import { capabilities, options } from "virtual:nimbus/agent-capabilities";
import { searchIndex } from "virtual:nimbus/config";
---

{capabilities.search === "pagefind" && (
  <meta
    name="nimbus-webmcp"
    content={JSON.stringify({
      search: capabilities.search,
      versions: capabilities.versions,
      site: options.site,
      title: options.title,
      base: options.base,
      bundle: searchIndex.bundle,
      merge: searchIndex.merge,
    })}
  />
)}

<script>
  import { initDocumentationWebMcp, mount } from "@cloudflare/nimbus-docs/client";

  mount('meta[name="nimbus-webmcp"]', (element) =>
    initDocumentationWebMcp(JSON.parse(element.getAttribute("content")!)),
  );
</script>
