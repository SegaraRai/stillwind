---
import { style } from "stillwind/astro";

import { highlightCss } from "../../lib/docs/candidates/highlight";
import { lookupCandidates, matchCaption } from "../../lib/docs/candidates/lookup";
import { documentationCompiler } from "../../lib/docs/reference/compiler";

const initial = "p-4";
const examples = [
  "p-4",
  "p-[16px]",
  "display: flex",
  "background-color: #3b82f6",
  "hover:underline",
  ":hover",
];
const { matches } = lookupCandidates((await documentationCompiler()).query, initial);
const control = style(
  "px-control block-11 inline-full min-inline-0 font-normal text-foreground bg-background rounded-control border border-border",
);
---

<div {...style("grid gap-5")} data-candidate-explorer>
  <form
    role="search"
    aria-label="Utility and variant lookup"
    {...style("grid p-panel gap-control bg-surface rounded-panel border border-border")}
  >
    <label for="candidate-query" {...style("text-ui font-medium")}>
      Utility, variant, or CSS
    </label>
    <input
      id="candidate-query"
      name="q"
      type="search"
      value={initial}
      placeholder="p-4, :hover, or display: flex"
      autocomplete="off"
      spellcheck="false"
      {...style(control, "font-mono")}
    />
    <div {...style("flex flex-wrap items-center gap-2 text-caption text-muted")}>
      <span>Try</span>
      {examples.map((example) => (
        <button
          type="button"
          data-example={example}
          {...style(
            "px-2 py-0.5 font-mono text-foreground bg-background rounded-inline border border-border cursor-pointer hover:bg-surface-muted",
          )}
        >
          {example}
        </button>
      ))}
    </div>
  </form>
  <p role="status" aria-live="polite" {...style("text-caption text-muted")}>
    Enable JavaScript to look up other utilities and variants. The results show an example.
  </p>
  <div data-candidate-results {...style("grid gap-5")}>
    {matches.map((match) => (
      <section {...style("candidate-result")}>
        <div {...style("candidate-result-header")}>
          <h3 {...style("candidate-result-title")}>
            <code>{match.candidate}</code>
          </h3>
          {matchCaption(match) && (
            <p {...style("candidate-result-caption")}>{matchCaption(match)}</p>
          )}
        </div>
        <pre
          {...style("candidate-result-code")}
        >{match.css ? <code set:html={highlightCss(match.css)} /> : <code>Adds a marker class and no declarations.</code>}</pre>
      </section>
    ))}
  </div>
</div>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client";

  import { mountCandidateExplorer } from "../../lib/docs/candidates/explorer";

  mount("[data-candidate-explorer]", mountCandidateExplorer);
</script>
