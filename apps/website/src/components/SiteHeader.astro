---
import { style } from "stillwind/astro";

interface Props {
  docs: string;
  repository: string;
}

const { docs, repository } = Astro.props;
---

<div data-header-slot>
  <header data-site-header>
    <a href="/" aria-label="Stillwind home" data-site-brand {...style("nav-link")}>Stillwind</a>
    <nav aria-label="Main navigation">
      <a href={docs} {...style("nav-link")}>Docs</a>
      <a href="#examples" {...style("nav-link")}>Examples</a>
      <a href={repository} {...style("nav-link")}>GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
</div>

<script>
  import { mountHeader } from "../lib/header";

  const slot = document.querySelector<HTMLElement>("[data-header-slot]");
  const story = document.querySelector<HTMLElement>("[data-story]");
  if (slot && story) {
    const dispose = mountHeader(slot, story);
    document.addEventListener("astro:before-swap", dispose, { once: true });
  }
</script>
