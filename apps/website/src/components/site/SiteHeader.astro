---
import { style } from "stillwind/astro";

import { URL_DOCS, URL_PLAYGROUND, URL_REPOSITORY } from "../../lib/config";
import { documentRoot } from "./document";

interface Props {
  /** Container of the page, which sets the width of the floating header. */
  container?: "page" | "docs";
}

const { container = "page" } = Astro.props;

const headerTransition = style.viewTransition({
  group: "duration-300 ease-out",
});
const link = style("inline-flex min-block-11 items-center whitespace-nowrap nav-link");
const header = style.ref();
---

<div data-header-slot {...style("block-16")}>
  <header
    data-site-header
    {...style(
      headerTransition.for("container"),
      header,
      "flex block-16 items-center justify-between gap-4 border-border border-be max-inline:gap-3",
      {
        "data-floating:": [
          "invisible fixed inset-x-0 inset-bs-0 z-40 mx-auto block-14 bg-background opacity-0",
          container === "page"
            ? "[inline-size:calc(min(100%,var(--container-page))-2*var(--spacing-gutter))]"
            : "[inline-size:calc(min(100%,var(--container-docs))-2*var(--spacing-docs-gutter))]",
          "-translate-y-full [transition:translate_180ms_ease,opacity_180ms_ease,visibility_180ms]",
          {
            "data-visible:": "visible opacity-100 translate-y-0",
            "motion-reduce:": "transition-none",
          },
        ],
      },
    )}
  >
    <a
      href="/"
      aria-label="Stillwind home"
      {...style(
        link,
        headerTransition.for("logo"),
        "text-heading/[inherit] tracking-[-0.045em] max-inline:text-heading-small/[inherit]",
        { [header("data-floating")]: "text-(length:--text-heading-small)" },
      )}
    >
      <span aria-label="Stillwind" role="img" {...style("stillwind-logo")}></span>
    </a>
    <nav
      aria-label="Main navigation"
      {...style(
        "flex items-center gap-7 text-ui/[inherit] max-inline:gap-2 max-inline:text-caption/[inherit]",
      )}
    >
      <a href={URL_PLAYGROUND} {...style(link, headerTransition.for("playground"))}>
        Playground
      </a>
      <a href={URL_DOCS} {...style(link, headerTransition.for("docs"))}>
        Docs
      </a>
      <a href={URL_REPOSITORY} {...style(link, headerTransition.for("github"), "gap-2")}>
        <span aria-hidden="true" {...style("icon-simple-icons--github")}></span>
        GitHub
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label="Color theme"
        hidden
        {...style(
          headerTransition.for("theme"),
          "inline-flex block-9 inline-9 shrink-0 items-center justify-center text-muted rounded-control cursor-pointer hover:text-foreground hover:bg-surface-muted [&[hidden]]:hidden",
        )}
      >
        <span
          aria-hidden="true"
          {...style("icon-control icon-lucide--monitor", {
            [documentRoot("data-[theme=light]")]: "hidden",
            [documentRoot("data-[theme=dark]")]: "hidden",
          })}
        ></span>
        <span
          aria-hidden="true"
          {...style("icon-control icon-lucide--sun", {
            [documentRoot("not-data-[theme=light]")]: "hidden",
          })}
        ></span>
        <span
          aria-hidden="true"
          {...style("icon-control icon-lucide--moon", {
            [documentRoot("not-data-[theme=dark]")]: "hidden",
          })}
        ></span>
        <span data-theme-status {...style("sr-only")} aria-live="polite"></span>
      </button>
    </nav>
  </header>
</div>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client";

  import { mountThemeControl } from "../../lib/site/theme";

  mount("[data-theme-toggle]", (button) => mountThemeControl(button as HTMLButtonElement));
</script>
