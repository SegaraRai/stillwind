---
import { style } from "stillwind/astro";

interface Props {
  docs: string;
  repository: string;
}

const { docs, repository } = Astro.props;
const headerTransition = style.viewTransition({ group: "duration-300 ease-out" });
---

<div data-header-slot>
  <header data-site-header {...style(headerTransition.for("site-header"))}>
    <a href="/" aria-label="Stillwind home" data-site-brand {...style("nav-link")}>
      Stillwind
    </a>
    <nav aria-label="Main navigation">
      <a href={docs} {...style("nav-link")}>
        Docs
      </a>
      <a href="/#examples" {...style("nav-link")}>
        Examples
      </a>
      <a href={repository} {...style("nav-link")}>
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <button type="button" data-theme-toggle aria-label="Color theme" hidden>
        <svg data-theme-icon="system" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="4" width="18" height="13" rx="2"></rect>
          <path d="M8 21h8m-4-4v4"></path>
        </svg>
        <svg data-theme-icon="light" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path>
        </svg>
        <svg data-theme-icon="dark" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"></path>
        </svg>
        <span data-theme-status {...style("sr-only")} aria-live="polite"></span>
      </button>
    </nav>
  </header>
</div>

<script>
  import { mountThemeControl } from "../../lib/site/theme";

  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (themeButton) {
    mountThemeControl(themeButton);
  }
</script>
