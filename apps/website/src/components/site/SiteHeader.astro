---
import { style } from "stillwind/astro";

interface Props {
  docs: string;
  repository: string;
}

const { docs, repository } = Astro.props;

const headerTransition = style.viewTransition({
  group: "duration-300 ease-out",
});
---

<div data-header-slot>
  <header data-site-header {...style(headerTransition.for("site-header"))}>
    <a href="/" aria-label="Stillwind home" data-site-brand {...style("nav-link")}>
      Stillwind
    </a>
    <nav aria-label="Main navigation">
      <a href={docs} {...style("nav-link")}>
        Docs
      </a>
      <a href="/#examples" {...style("nav-link")}>
        Examples
      </a>
      <a href={repository} {...style("gap-2 nav-link")}>
        <span aria-hidden="true" {...style("icon-simple-icons--github")}></span>
        GitHub
      </a>
      <button type="button" data-theme-toggle aria-label="Color theme" hidden>
        <span
          data-theme-icon="system"
          aria-hidden="true"
          {...style("icon-control icon-lucide--monitor")}
        ></span>
        <span
          data-theme-icon="light"
          aria-hidden="true"
          {...style("icon-control icon-lucide--sun")}
        ></span>
        <span
          data-theme-icon="dark"
          aria-hidden="true"
          {...style("icon-control icon-lucide--moon")}
        ></span>
        <span data-theme-status {...style("sr-only")} aria-live="polite"></span>
      </button>
    </nav>
  </header>
</div>

<script>
  import { mountThemeControl } from "../../lib/site/theme";

  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (themeButton) {
    mountThemeControl(themeButton);
  }
</script>
