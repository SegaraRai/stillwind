<meta name="color-scheme" content="light dark" />
<script is:inline>
  // The client router replaces the root attributes on navigation, so the stored theme is applied
  // again after each swap.
  {
    const applyTheme = () => {
      try {
        const preference = localStorage.getItem("stillwind:theme");
        if (preference === "light" || preference === "dark") {
          document.documentElement.dataset.theme = preference;
        }
      } catch {}
    };
    applyTheme();
    document.addEventListener("astro:after-swap", applyTheme);
  }
</script>
