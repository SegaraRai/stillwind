---
import { style } from "stillwind/astro";

import { featureTopics } from "../lib/features/examples";
import { featureScrollLength } from "../lib/features/scenes";
import FeatureSource from "./FeatureSource.astro";

const contracts = "https://github.com/SegaraRai/stillwind/blob/main/docs/macro-contract.md";
const stops = featureTopics.flatMap((topic) =>
  topic.frames.map((frame) => ({
    topic: topic.name,
    label: frame.label,
  })),
);
---

<section
  id="features"
  data-features
  style={"--feature-length: " + featureScrollLength}
  aria-labelledby="features-title"
>
  <div data-feature-stage>
    <nav data-feature-nav aria-label="More ways to use Stillwind">
      <ol>
        {featureTopics.map((topic, index) => (
          <li>
            <a href={"#" + topic.id} data-feature-step={index} {...style("feature-step")}>
              <span aria-hidden="true" data-feature-dot></span>
              <span>{topic.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <h2 id="features-title" {...style("section-title")}>
      Express more with familiar CSS.
    </h2>

    <div data-feature-panels>
      {featureTopics.map((topic, index) => (
        <article id={topic.id} data-feature-panel={index} aria-label={topic.name}>
          <p data-feature-description>{topic.frames[0].description}</p>
          <div data-feature-source-heading>
            <p data-feature-caption>{topic.frames[0].label}</p>
            <span data-feature-counter>
              {"01 / " + String(topic.frames.length).padStart(2, "0")}
            </span>
          </div>
          <div data-feature-canvas data-code-canvas>
            <svg data-feature-lines aria-hidden="true">
              <path data-feature-line />
            </svg>
            <div data-feature-source data-feature-morph={index === 0 || undefined}>
              <FeatureSource topic={index} frames={topic.frames} />
            </div>
          </div>
        </article>
      ))}
    </div>

    <div data-feature-footer>
      <div data-feature-paging aria-label="Examples">
        <button type="button" data-feature-direction="-1" aria-label="Previous example" disabled>
          ←
        </button>
        <button type="button" data-feature-direction="1" aria-label="Next example">
          →
        </button>
      </div>
      <div data-feature-cues aria-label="Examples">
        {stops.map((stop, index) => (
          <button
            type="button"
            data-feature-cue={index}
            aria-label={stop.topic + ": " + stop.label}
            title={stop.label}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span></span>
          </button>
        ))}
      </div>
      <a href={contracts} {...style("nav-link text-caption text-muted")}>
        Explore the API ↗
      </a>
    </div>
    <div data-feature-progress-area>
      <div data-feature-progress aria-hidden="true">
        <span></span>
      </div>
      <p data-feature-scroll-hint {...style("mbs-4 text-end font-mono text-label text-muted")}>
        Scroll to explore ↓
      </p>
    </div>
  </div>
</section>

<script>
  import { mountFeatures } from "../lib/features";

  const features = document.querySelector<HTMLElement>("[data-features]");
  if (features) {
    const dispose = mountFeatures(features);
    document.addEventListener("astro:before-swap", dispose, { once: true });
  }
</script>
