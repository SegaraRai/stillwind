---
import { style } from "stillwind/astro";

import { STREAMLINE_COUNT } from "../../lib/landing/backdrop";

const gust = style.keyframes({
  from: "[stroke-dashoffset:1000]",
  to: "[stroke-dashoffset:0]",
});

const streamlines = Array.from({ length: STREAMLINE_COUNT }, (_, index) => index);

// Every third streamline carries a gust, with its own speed and phase.
const gusts = streamlines
  .filter((index) => index % 3 === 0)
  .map((index) => ({
    index,
    timing: `animation-duration: ${16 + ((index * 7) % 11)}s; animation-delay: ${-((index * 5.3) % 20)}s`,
  }));
---

<div aria-hidden="true" data-backdrop {...style("backdrop")}>
  <div data-backdrop-lattice {...style("backdrop-rows")}></div>
  <div {...style("backdrop-columns")}></div>
  <svg preserveAspectRatio="none" {...style("absolute inset-0 block-full inline-full")}>
    <g {...style("[opacity:var(--backdrop-base-opacity,1)]")}>
      {streamlines.map((index) => (
        <path
          data-streamline={index}
          {...style(
            "fill-none stroke-backdrop-streamline stroke-1 [vector-effect:non-scaling-stroke]",
          )}
        />
      ))}
    </g>
    <g {...style("[opacity:var(--backdrop-gust-opacity,1)] motion-reduce:hidden")}>
      {gusts.map(({ index, timing }) => (
        <path
          data-streamline={index}
          pathLength="1000"
          style={timing}
          {...style(
            gust("ease-linear infinite"),
            "fill-none stroke-accent stroke-[1.25] opacity-60 [stroke-linecap:round] [stroke-dasharray:60_940] [vector-effect:non-scaling-stroke]",
          )}
        />
      ))}
    </g>
  </svg>
</div>

<script>
  import { mountBackdrop } from "../../lib/landing/backdrop";

  const backdrop = document.querySelector<HTMLElement>("[data-backdrop]");
  const hero = document.querySelector<HTMLElement>("[data-backdrop-hero]");
  if (backdrop && hero) {
    const dispose = mountBackdrop(backdrop, hero);
    document.addEventListener("astro:before-swap", dispose, {
      once: true,
    });
  }
</script>
