---
import { style } from "stillwind/astro";

import FeaturePreview from "./FeaturePreview.astro";
import { featureExample, featureSource, features } from "./presentation";

interface Props {
  topic: number;
  frames: readonly {
    source: string;
    focus: string;
    label: string;
    description: string;
  }[];
}

const { topic, frames } = Astro.props;

const tokenize = (source: string, frame: number) => {
  const counts = new Map<string, number>();
  return [...source.matchAll(/"(?:[^"\\]|\\.)*"|[a-zA-Z_$][\w$]*|\d+|\s+|./g)].map((match) => {
    const text = match[0];
    const punctuation = !text.startsWith('"') && !/^[\w$\s]/.test(text);
    const count = counts.get(text) ?? 0;
    counts.set(text, count + 1);
    return {
      text,
      punctuation,
      key:
        (text.startsWith('"') || /^[\w$]/.test(text) ? "value-" : "syntax-" + frame + "-") +
        text +
        "-" +
        count,
      start: match.index,
    };
  });
};

const specimens = frames.map((frame, index) => {
  const start = frame.source.indexOf(frame.focus);
  if (start < 0) {
    throw new Error("A source connector must identify text in its specimen.");
  }

  const parts = tokenize(frame.source, index);
  const runs: {
    focused: boolean;
    parts: typeof parts;
  }[] = [];
  for (const part of parts) {
    const focused =
      part.start >= start && part.start < start + frame.focus.length && !part.text.includes("\n");
    const previous = runs.at(-1);
    if (previous?.focused === focused) {
      previous.parts.push(part);
    } else {
      runs.push({ focused, parts: [part] });
    }
  }
  return runs;
});
---

<div
  {...style("absolute inset-0 hidden pointer-events-none select-none", {
    [features("data-enhanced:not-data-compact")]: {
      [featureSource("data-feature-morph")]: "z-1 block",
    },
  })}
  data-code-actors
  aria-hidden="true"
></div>
<div
  {...style(
    "absolute inset-0 hidden overflow-clip opacity-(--focus-opacity,1) pointer-events-none",
    {
      [features("data-enhanced")]: "block",
    },
  )}
  data-feature-highlights
  aria-hidden="true"
></div>
{specimens.map((runs, index) => (
  <div
    {...style(featureExample, {
      [features("not-data-enhanced")]: "relative mbe-14",
      [features("data-enhanced")]: [
        "invisible absolute inset-0",
        {
          "data-current:": "visible",
        },
      ],
    })}
    data-feature-example={index}
    data-current={index === 0 || undefined}
  >
    <div
      {...style("mbe-5 font-sans tracking-normal", {
        [features("data-enhanced")]: "hidden",
      })}
    >
      <p {...style("mbe-2.5 font-mono text-[11px]/normal text-muted")}>{frames[index].label}</p>
      <p {...style("max-inline-165 text-muted text-small/[1.6]")}>{frames[index].description}</p>
    </div>
    <pre
      {...style(
        "visible relative inset-s-0 inset-bs-0 block mbe-8 inline-full flex-wrap gap-y-[0.5em] [font-family:inherit] whitespace-pre select-text code-font",
        {
          [features("data-enhanced")]: [
            "invisible absolute m-0 select-none",
            {
              "data-current:": "visible select-text",
              "max-outline:": "inline-[calc(100%-324px)]",
              "max-sidebar:": "inline-full",
            },
          ],
          [features("data-enhanced:not-data-compact")]: {
            [featureSource("data-feature-morph")]: "text-transparent",
          },
          "max-outline:": "wrap-anywhere whitespace-pre-wrap",
          [features("not-data-enhanced")]: "mbe-0 wrap-anywhere whitespace-pre-wrap",
        },
      )}
      data-measure
      data-feature-frame={index}
      data-current={index === 0 || undefined}
    ><code {...style("[font-family:inherit] code-font")}>{runs.map((run) =>
        run.focused ? (
          <mark
            {...style(
              "box-decoration-clone text-inherit bg-surface-muted shadow-[inset_0_-1px_var(--color-foreground)]",
              {
                [features("data-enhanced")]: "bg-transparent shadow-none",
              },
            )}
            data-feature-origin
            >{run.parts.map((part) => (
              <span
                data-part={part.key}
                data-code-punctuation={part.punctuation || undefined}
                set:text={part.text}
              />
              ))}</mark>
        ) : (
          run.parts.map((part) => (
            <span
              data-part={part.key}
              data-code-punctuation={part.punctuation || undefined}
              set:text={part.text}
            />
          ))
        ),
      )}</code></pre>
    <FeaturePreview topic={topic} frame={index} />
  </div>
))}
