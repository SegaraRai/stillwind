---
import type { ErrorCategory } from "./compiler-error";
interface Props {
  code: string;
  category: ErrorCategory;
}
const { code, category } = Astro.props;
---

<div class="reference-summary">
  <p>
    Reporting code:{" "}
    <strong>
      <code>{code}</code>
    </strong>
    . Category: <strong>{category}</strong>.
  </p>
  <p>This is a fatal compiler error. Lint settings and suppression comments cannot disable it.</p>
  <p>
    <a href="https://github.com/SegaraRai/stillwind/blob/main/crates/diagnostics/src/compilation/code.rs">
      Reporting-code ledger
    </a>
    {" · "}
    <a href="https://github.com/SegaraRai/stillwind/blob/main/crates/diagnostics/src/compilation/diagnostic.rs">
      Diagnostic payload
    </a>
  </p>
</div>
