---
import { Code } from "astro:components";

import { compileExample } from "./compiled-example";
interface Props {
  source: string;
}
const example = await compileExample(Astro.props.source);
const theme = { light: "github-light", dark: "github-dark" } as const;
---

<div class="compiled-example">
  <h3>Source</h3>
  <Code code={example.source} lang="tsx" themes={theme} defaultColor={false} />
  <h3>Development JavaScript</h3>
  <Code code={example.development} lang="ts" themes={theme} defaultColor={false} />
  <h3>Production JavaScript</h3>
  <Code code={example.production} lang="ts" themes={theme} defaultColor={false} />
  <h3>Module CSS</h3>
  {example.css ? (
    <Code code={example.css} lang="css" themes={theme} defaultColor={false} />
  ) : (
    <p>
      This example contributes no document CSS. Exported CSS text appears in its JavaScript string.
    </p>
  )}
  {example.documentCss && (
    <details>
      <summary>Complete document stylesheet, including theme, reset, and support</summary>
      <Code code={example.documentCss} lang="css" themes={theme} defaultColor={false} />
    </details>
  )}
</div>
