---
import { style } from "stillwind/astro";

import { styleParts } from "../lib/code-morph";
import { createExamples } from "../lib/examples";
import { showcaseScenes, showcaseScrollLength } from "../lib/showcase";

const examples = await createExamples();
const keys = ["block", "text", "inline", "color", "shape"];
const frames = [
  {
    id: "check",
    name: "Check",
    description:
      "A familiar utility can still contain a typo. Stillwind resolves each utility and reports what needs your attention.",
    utilities: examples.unchecked,
    reports: [examples.unknown],
  },
  {
    id: "constrain",
    name: "Constrain",
    description:
      "Define lint rules for colors and breakpoints. Stillwind applies those rules in editors, agents, and CI.",
    utilities: examples.restricted,
    reports: examples.restrictions,
  },
  {
    id: "format",
    name: "Normalize & Format",
    description:
      "Stillwind normalizes equivalent utilities and sorts them into a consistent order. Make code easier to read, review, and change.",
    utilities: examples.unordered,
    reports: examples.canonical,
  },
  {
    id: "compile",
    name: "Compile",
    description: "Stillwind compiles static utilities to framework props and CSS you can inspect.",
    utilities: examples.compiled,
    reports: [],
  },
];
const keysByUtility = new Map(
  examples.canonicalized.split(" ").map((utility, index) => [utility, keys[index]!]),
);
const sortedKeys = examples.ordered.split(" ").map((utility) => keysByUtility.get(utility)!);
const groupParts = (frame: (typeof frames)[number]) => {
  const frameKeys = frame.utilities === examples.ordered ? sortedKeys : keys;
  const parts = styleParts(
    frame.utilities,
    frameKeys,
    frame.reports.map((report) => frameKeys[report.utilityIndex]!),
  );
  const groups: (typeof parts)[] = [];
  for (const part of parts) {
    const previous = groups.at(-1);
    if (part.utility && previous?.[0]?.utility === part.utility) {
      previous.push(part);
    } else {
      groups.push([part]);
    }
  }
  return groups;
};
const partGroups = frames.map(groupParts);
const sources = [
  frames[0]!,
  frames[1]!,
  frames[2]!,
  { ...frames[2]!, utilities: examples.canonicalized, reports: [] },
  { ...frames[2]!, utilities: examples.ordered, reports: [] },
  frames[3]!,
];
const sourceLabels = ["Original", "Normalized", "Formatted", "Input"];
const policy = '{\n  "no-arbitrary-breakpoints": "deny",\n  "no-arbitrary-colors": "deny",\n}';
const sorted = 'style("' + examples.ordered + '")';
const normalized = 'style("' + examples.canonicalized + '")';
const props = '{ className: "' + examples.cssClassName + '" }';
const results = [
  {
    label: sourceLabels[1],
    source: normalized,
    command: "$ stillwind lint --fix",
  },
  {
    label: sourceLabels[2],
    source: sorted,
    command: "$ stillwind fmt",
  },
];
---

<section
  id="examples"
  data-story
  aria-labelledby="style-title"
  {...style("scroll-story", {
    "--stop-count": showcaseScenes.length,
    "--showcase-length": showcaseScrollLength,
  })}
>
  <div data-stage>
    <nav
      aria-label="Examples"
      {...style("grid grid-cols-2 gap-x-6 inline:grid-cols-4 inline:gap-3 sidebar:gap-6")}
    >
      {frames.map((frame, index) => (
        <a
          href={"#" + frame.id}
          data-step={index}
          {...style(
            "flex items-center justify-between text-muted text-caption scene-tab sidebar:text-small",
          )}
        >
          <span>
            <span {...style("me-2 font-mono text-label sidebar:me-3 sidebar:text-caption")}>
              0{index + 1}
            </span>
            {frame.name}
          </span>
          <span aria-hidden="true" {...style("hidden font-mono sidebar:inline")}>
            ↘
          </span>
        </a>
      ))}
    </nav>

    <div data-showcase-intro>
      <h2 id="style-title" {...style("section-title")}>
        Write with confidence.
      </h2>
      <div data-live-description hidden>
        <div data-headings>
          {frames.map((frame, index) => (
            <div data-heading={index}>
              <p {...style("max-inline-105 text-muted text-small/relaxed")}>{frame.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div data-live-demo hidden>
      <div data-code-canvas {...style("font-mono")}>
        <div data-primary-code>
          <div data-code-host {...style("morph-source")}>
            <code data-readable-source {...style("readable-source")}>
              {'style("' + frames[0]!.utilities + '")'}
            </code>
            <div data-code-actors aria-hidden="true"></div>
            <div aria-hidden="true" inert>
              {sources.map((source, index) => (
                <div
                  data-measure
                  data-source={'style("' + source.utilities + '")'}
                  data-sort-source={index === 3 || undefined}
                >
                  {groupParts(source).map((parts) => (
                    <span
                      data-utility={parts[0]!.utility}
                      data-finding={parts[0]!.finding || undefined}
                    >
                      {parts.map((part) => (
                        <span data-part={part.key}>{part.text}</span>
                      ))}
                    </span>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>

        <div data-source-labels aria-hidden="true">
          {sourceLabels.map((label, index) => (
            <span data-source-label={index}>{label}</span>
          ))}
        </div>

        <div data-details>
          {frames.map((frame, index) => (
            <div data-detail={index}>
              {index < 3 ? (
                <div>
                  <div
                    data-diagnostics={frame.id}
                    data-format-diagnostics={frame.id === "format" || undefined}
                    data-multiple={frame.reports.length > 1 || undefined}
                    {...style("text-danger")}
                  >
                    <svg data-diagnostic-lines aria-hidden="true">
                      {frame.reports.map((report) => (
                        <path data-diagnostic-line={keys[report.utilityIndex]} />
                      ))}
                    </svg>
                    {frame.reports.map((report) => (
                      <div data-diagnostic={keys[report.utilityIndex]}>
                        <p {...style("mbe-2 font-sans text-small")}>{report.code}</p>
                        <p {...style("text-caption leading-[1.7]")}>{report.message}</p>
                      </div>
                    ))}
                  </div>
                  {frame.id === "constrain" && (
                    <div data-lint-config>
                      <p {...style("mbe-3 text-muted text-caption")}>
                        stillwind.config.ts · lint.rules
                      </p>
                      <pre {...style("text-caption/[1.8] code-scroll")}><code>{policy}</code></pre>
                    </div>
                  )}
                  {frame.id === "format" && (
                    <p data-format-command {...style("text-muted text-caption")}>
                      <span data-normalize-command>$ stillwind lint --fix</span>
                      <span data-sort-command>$ stillwind fmt</span>
                    </p>
                  )}
                </div>
              ) : (
                <div data-compile-output>
                  <div data-compiled-props>
                    <p {...style("mbe-3 text-muted text-caption/[1]")}>Output (React)</p>
                    <code>{props}</code>
                  </div>
                  <div data-compiled-css>
                    <p {...style("mbe-3 text-muted text-caption/[1]")}>Compiled CSS</p>
                    <pre
                      {...style("text-caption/[1.7] code-scroll")}
                    ><code>{examples.css}</code></pre>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
        <div data-compile-arrows aria-hidden="true">
          <span>↳</span>
        </div>
      </div>

      <div data-story-progress aria-hidden="true" {...style("block-px bg-border")}>
        <div data-progress {...style("block-full bg-action")}></div>
      </div>
      <p data-scroll-hint {...style("mbs-4 text-end font-mono text-label text-muted")}>
        Scroll to explore ↓
      </p>
    </div>
  </div>

  <div data-fallback>
    {frames.map((frame, index) => (
      <article
        id={frame.id}
        data-stop
        {...style("scene", {
          "--stop-index": showcaseScenes.findIndex((scene) => scene === index),
        })}
      >
        <h3 {...style("mbe-4 text-lead tracking-tight")}>{frame.name}</h3>
        <p {...style("mbs-5 max-inline-105 text-muted text-small/relaxed")}>{frame.description}</p>
        {frame.id === "format" && (
          <p {...style("mbs-7 font-mono text-muted text-caption")}>{sourceLabels[0]}</p>
        )}
        {frame.id === "compile" && (
          <p {...style("mbs-7 font-mono text-muted text-caption")}>Input</p>
        )}
        <div
          data-static-source
          data-compile-input={frame.id === "compile" || undefined}
          {...style("font-mono text-lead")}
        >
          {partGroups[index]!.map((parts) => (
            <div data-static-part data-static-finding={parts[0]!.finding || undefined}>
              <code>{parts.map((part) => part.text).join("")}</code>
              {frame.reports
                .filter((report) => keys[report.utilityIndex] === parts[0]!.utility)
                .map((report) => (
                  <div data-static-diagnostic {...style("text-danger")}>
                    <p {...style("mbe-2 font-sans text-small")}>{report.code}</p>
                    <p {...style("max-inline-90 text-caption leading-[1.7]")}>{report.message}</p>
                  </div>
                ))}
            </div>
          ))}
        </div>
        {frame.id === "constrain" && <pre
          {...style("mbs-7 font-mono text-caption/[1.9] code-scroll")}
        ><code>{policy}</code></pre>}
        {frame.id === "format" &&
          results.map((result) => (
            <div {...style("mbs-7")}>
              <p {...style("mbe-3 font-mono text-muted text-caption")}>{result.label}</p>
              <div {...style("code-scroll")}>
                <code {...style("font-mono text-lead")}>{result.source}</code>
              </div>
              <p {...style("mbs-5 font-mono text-muted text-caption")}>{result.command}</p>
            </div>
          ))}
        {frame.id === "compile" && (
          <div data-static-compile>
            <div>
              <p {...style("mbe-3 font-mono text-muted text-caption")}>Output (React)</p>
              <code {...style("block font-mono text-small")}>{props}</code>
            </div>
            <div>
              <p {...style("mbe-3 font-mono text-muted text-caption")}>Compiled CSS</p>
              <pre
                {...style("font-mono text-caption/[1.9] code-scroll")}
              ><code>{examples.css}</code></pre>
            </div>
            <div data-compile-arrows aria-hidden="true">
              <span>↳</span>
            </div>
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<script>
  import { mountShowcase } from "../lib/showcase";

  const story = document.querySelector<HTMLElement>("[data-story]");
  if (story) {
    mountShowcase(story);
  }
</script>
