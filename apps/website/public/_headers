# The utility lookup runs the threaded WASM compiler, which needs a cross-origin isolated page.
# Its worker scripts must also carry the embedder policy.
/docs/utilities
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Asset file names contain a content hash, so a changed file always has a new URL.
/_astro/*
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: public, max-age=31536000, immutable

# Markdown alternates repeat the HTML pages. Search results must link to the HTML pages.
/index.md
  X-Robots-Tag: noindex

/*/index.md
  X-Robots-Tag: noindex

/*/index.mdx
  X-Robots-Tag: noindex
